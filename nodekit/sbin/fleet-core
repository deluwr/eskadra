#!/usr/bin/env bash
# /usr/local/sbin/fleet-core — ядра VPN под управлением Эскадры (отдельно от любых сторонних панелей на хосте).
#   install <xray|sing-box> <version> <sha256>   скачать официальный релиз, проверить sha256, установить
#   apply   <xray|sing-box> <staged.json>         проверить конфиг, подменить атомарно, перезапустить, откатить при сбое
#   status|stop <core> · x25519 · stats · tls <sni>
#   cert-issue <имя> ip|domain <значение>     Let's Encrypt на IP или домен узла (certbot, HTTP-01), автопродление
#   cert-set <имя> <fullchain> <privkey>      загруженный сертификат (общий домен / wildcard)
# Ядра: xray, sing-box, telemt (MTProto).
set -euo pipefail
LIB="${FLEET_CORE_LIB:-/usr/local/lib/eskadra}"
ETC="${FLEET_CORE_ETC:-/etc/eskadra}"
BIN="${FLEET_CORE_BIN:-/usr/local/bin}"
UNITS="${FLEET_CORE_UNITS:-/etc/systemd/system}"
die() { echo "$*" >&2; exit 1; }

arch() {
  case "$(uname -m)" in
    x86_64) echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    *) die "unsupported arch $(uname -m)" ;;
  esac
}
bin_of() { echo "$BIN/eskadra-$1"; }
unit_of() { echo "eskadra-$1.service"; }
cfg_of() { if [ "$1" = telemt ]; then echo "$ETC/telemt/config.toml"; else echo "$ETC/$1/config.json"; fi; }

url_of() {  # официальные релизы на GitHub; версия без префикса v
  local core="$1" v="$2" a; a="$(arch)"
  if [ "$core" = xray ]; then
    local x; [ "$a" = amd64 ] && x=64 || x=arm64-v8a
    echo "https://github.com/XTLS/Xray-core/releases/download/v$v/Xray-linux-$x.zip"
  elif [ "$core" = telemt ]; then
    local x; [ "$a" = amd64 ] && x=x86_64 || x=aarch64
    echo "https://github.com/telemt/telemt/releases/download/$v/telemt-$x-linux-musl.tar.gz"
  else
    echo "https://github.com/SagerNet/sing-box/releases/download/v$v/sing-box-$v-linux-$a.tar.gz"
  fi
}

write_unit() {
  local core="$1" bin cfg run
  bin="$(bin_of "$core")"; cfg="$(cfg_of "$core")"
  run="$bin run -c $cfg"
  local env=""
  [ "$core" = xray ] && env="Environment=XRAY_LOCATION_ASSET=$(dirname "$(readlink -f "$bin")")"
  # telemt: «telemt config.toml», кэш TLS-эмуляции (tls_front_dir) — в каталоге конфига
  [ "$core" = telemt ] && { run="$bin $cfg"; env="WorkingDirectory=$ETC/telemt"; }
  cat > "$UNITS/$(unit_of "$core").new" <<EOF
[Unit]
Description=Eskadra $core
After=network-online.target
Wants=network-online.target

[Service]
$env
ExecStart=$run
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
EOF
  mv "$UNITS/$(unit_of "$core").new" "$UNITS/$(unit_of "$core")"
  systemctl daemon-reload
}

exe_of() { echo "$LIB/$1/$2/$1"; }

link_to() {  # переключить /usr/local/bin/eskadra-<core> на версию и переписать юнит
  local core="$1" v="$2" bin; bin="$(bin_of "$core")"
  ln -sfn "$(exe_of "$core" "$v")" "$bin.new" && mv -T "$bin.new" "$bin"
  write_unit "$core"
  echo "$v" > "$LIB/$core/current"
}

test_cfg() {  # test_cfg <core> <version>: принимает ли версия текущий конфиг
  local core="$1" v="$2" cfg exe; cfg="$(cfg_of "$core")"; exe="$(exe_of "$core" "$v")"
  [ -f "$cfg" ] || return 0
  [ "$core" = telemt ] && return 0
  if [ "$core" = xray ]; then XRAY_LOCATION_ASSET="$(dirname "$exe")" "$exe" run -test -c "$cfg" >/dev/null 2>&1
  else "$exe" check -c "$cfg" >/dev/null 2>&1; fi
}

restart_ok() {  # перезапустить, если ядро должно работать; вернуть 0, если поднялось
  local core="$1" unit; unit="$(unit_of "$core")"
  [ -f "$(cfg_of "$core")" ] || return 0
  systemctl is-enabled --quiet "$unit" 2>/dev/null || return 0
  systemctl restart "$unit"; sleep 2
  systemctl is-active --quiet "$unit"
}

# Установка и обновление одной командой:
#   новая версия ставится рядом → текущий конфиг проверяется новым бинарником → переключение → перезапуск;
#   если ядро не поднялось — автоматический возврат на прежнюю версию.
cmd_install() {
  local core="$1" v="$2" sha="$3" url dest prev tmp
  [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.][A-Za-z0-9.]+)?$ ]] || die "bad version"
  [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || die "bad sha256"
  prev="$(cat "$LIB/$core/current" 2>/dev/null || true)"
  [ "$prev" = "$v" ] && [ -x "$(exe_of "$core" "$v")" ] && { echo "already $core $v"; return 0; }
  dest="$LIB/$core/$v"
  if [ ! -x "$(exe_of "$core" "$v")" ]; then
    url="$(url_of "$core" "$v")"
    tmp="$(mktemp -d)"; _CLEANUP="$tmp"; trap 'rm -rf "${_CLEANUP:-}"' EXIT
    curl -fsSL --retry 3 --max-time 300 -o "$tmp/pkg" "$url" || die "download failed: $url"
    echo "$sha  $tmp/pkg" | sha256sum -c --quiet - || die "sha256 mismatch"
    install -d -m 755 "$dest.new"
    if [ "$core" = xray ]; then
      python3 -m zipfile -e "$tmp/pkg" "$tmp/x"
      install -m 755 "$tmp/x/xray" "$dest.new/xray"
      for f in geoip.dat geosite.dat; do [ -f "$tmp/x/$f" ] && install -m 644 "$tmp/x/$f" "$dest.new/$f"; done
    elif [ "$core" = telemt ]; then
      tar -xzf "$tmp/pkg" -C "$tmp"
      install -m 755 "$tmp/telemt" "$dest.new/telemt"
    else
      tar -xzf "$tmp/pkg" -C "$tmp"
      install -m 755 "$tmp"/sing-box-*/sing-box "$dest.new/sing-box"
    fi
    rm -rf "$dest"; mv "$dest.new" "$dest"
  fi
  drop_rejected() { [ "$v" = "$prev" ] || rm -rf "$dest"; }
  test_cfg "$core" "$v" || { drop_rejected; die "$core $v не принимает текущий конфиг — обновление отменено, работает $prev"; }
  install -d -m 750 "$ETC/$core"
  link_to "$core" "$v"
  if ! restart_ok "$core"; then
    journalctl -u "$(unit_of "$core")" -n 15 --no-pager >&2 || true
    if [ -n "$prev" ] && [ -x "$(exe_of "$core" "$prev")" ]; then
      link_to "$core" "$prev"; restart_ok "$core" || true; drop_rejected
      die "$core $v не запустился — возвращена версия $prev"
    fi
    die "$core $v не запустился"
  fi
  [ -n "$prev" ] && [ "$prev" != "$v" ] && echo "$prev" > "$LIB/$core/previous"
  # храним текущую и предыдущую версии, остальные удаляем
  for d in "$LIB/$core"/*/; do
    d="${d%/}"; b="$(basename "$d")"
    [ "$b" = "$v" ] || [ "$b" = "$prev" ] || rm -rf "$d"
  done
  echo "installed $core $v${prev:+ (было $prev)}"
}

cmd_rollback() {  # вернуть предыдущую версию ядра
  local core="$1" prev cur
  prev="$(cat "$LIB/$core/previous" 2>/dev/null || true)"; cur="$(cat "$LIB/$core/current" 2>/dev/null || true)"
  [ -n "$prev" ] && [ -x "$(exe_of "$core" "$prev")" ] || die "предыдущей версии $core нет"
  test_cfg "$core" "$prev" || die "$core $prev не принимает текущий конфиг"
  link_to "$core" "$prev"
  restart_ok "$core" || { link_to "$core" "$cur"; restart_ok "$core" || true; die "$core $prev не запустился — оставлена $cur"; }
  echo "$cur" > "$LIB/$core/previous"
  echo "rolled back $core to $prev (было $cur)"
}

cmd_apply() {
  local core="$1" staged="$2" bin cfg unit
  bin="$(bin_of "$core")"; cfg="$(cfg_of "$core")"; unit="$(unit_of "$core")"
  [ -x "$bin" ] || die "$core not installed"
  if [ "$core" = xray ]; then
    XRAY_LOCATION_ASSET="$(dirname "$(readlink -f "$bin")")" "$bin" run -test -c "$staged" >/dev/null || die "config test failed"
  elif [ "$core" = sing-box ]; then
    "$bin" check -c "$staged" || die "config check failed"
  fi
  install -d -m 750 "$ETC/$core"
  if [ "$core" = telemt ] && [ -f "$cfg" ] && systemctl is-active --quiet "$unit" \
     && [ "$(sed '/^\[access/,$d' "$cfg")" = "$(sed '/^\[access/,$d' "$staged")" ]; then
    # telemt сам подхватывает [access.*] (пользователи, лимиты) — соединения Telegram не рвём
    install -m 600 "$staged" "$cfg.new" && mv "$cfg.new" "$cfg"
    echo "applied telemt (users reloaded without restart)"; return 0
  fi
  [ -f "$cfg" ] && cp -a "$cfg" "$cfg.prev"
  install -m 600 "$staged" "$cfg.new" && mv "$cfg.new" "$cfg"
  systemctl enable "$unit" >/dev/null 2>&1 || true
  systemctl restart "$unit"
  sleep 2
  if ! systemctl is-active --quiet "$unit"; then
    journalctl -u "$unit" -n 20 --no-pager >&2 || true
    if [ -f "$cfg.prev" ]; then mv "$cfg.prev" "$cfg"; systemctl restart "$unit" || true; echo "ROLLED BACK to previous config" >&2; fi
    die "$core failed to start"
  fi
  echo "applied $core"
}

cmd_status() {
  local core="$1"
  echo "version=$(cat "$LIB/$core/current" 2>/dev/null || echo none)"
  echo "previous=$(cat "$LIB/$core/previous" 2>/dev/null || echo none)"
  echo "active=$(systemctl is-active "$(unit_of "$core")" 2>/dev/null || true)"
  echo "listen:"; ss -ltnupH 2>/dev/null | grep -E "eskadra|\"(xray|sing-box|telemt)\"" | awk '{print $1" "$5}' || true
}

cmd_probe() {  # probe <локальный SOCKS-порт выхода> <байт>: задержка (мс) и скорость скачивания (Мбит/с) через этот выход
  local port="$1" bytes="$2" t s
  [[ "$port" =~ ^[0-9]{2,5}$ ]] && [[ "$bytes" =~ ^[0-9]{1,9}$ ]] || die "usage: probe <port> <bytes>"
  # задержка — как у наблюдения Xray: HTTPS-запрос к generate_204 через выход (лучший из трёх)
  local best=""
  for _ in 1 2 3; do
    t="$(curl -s -o /dev/null -w '%{time_total}' --max-time 10 --socks5-hostname "127.0.0.1:$port" https://www.gstatic.com/generate_204 || true)"
    [[ "$t" =~ ^[0-9.]+$ ]] && [ "$t" != "0.000000" ] || continue
    if [ -z "$best" ] || awk -v a="$t" -v b="$best" 'BEGIN{exit !(a<b)}'; then best="$t"; fi
  done
  [ -n "$best" ] && echo "rtt_ms=$(awk -v t="$best" 'BEGIN{printf "%d", t*1000}')" || echo "rtt_ms=fail"
  [ "$bytes" = 0 ] && return 0   # только задержка (быстрая проверка закреплённого выхода)
  s="$(curl -s -o /dev/null -w '%{speed_download}' --max-time 40 --socks5-hostname "127.0.0.1:$port" "https://speed.cloudflare.com/__down?bytes=$bytes" || true)"
  if [[ "$s" =~ ^[0-9.]+$ ]] && [ "${s%%.*}" != "0" ]; then echo "mbps=$(awk -v b="$s" 'BEGIN{printf "%.1f", b*8/1000000}')"; else echo "mbps=fail"; fi
}

cmd_hoststat() {  # сырые счётчики хоста для живой статистики панели (разбирает и считает скорости панель)
  echo "@stat"; head -1 /proc/stat
  echo "@meminfo"; grep -E '^(MemTotal|MemAvailable):' /proc/meminfo
  echo "@netdev"; tail -n +3 /proc/net/dev
  echo "@uptime"; cat /proc/uptime
  echo "@loadavg"; cat /proc/loadavg
  echo "@nproc"; nproc 2>/dev/null || echo 1
  echo "@df"; df -PB1 / 2>/dev/null | tail -1
  echo "@ip"; ip -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); print a[1]}'
}

cmd_bo() {  # bo <балансировщик> <outbound|clear>: переключить выбор балансировщика Xray на лету (без перезапуска)
  local bin; bin="$(bin_of xray)"
  [ -x "$bin" ] || die "xray not installed"
  if [ "$2" = clear ]; then "$bin" api bo --server=127.0.0.1:10085 -b "$1" -r
  else "$bin" api bo --server=127.0.0.1:10085 -b "$1" "$2"; fi
  echo "balancer $1 -> $2"
}

cmd_x25519() {  # выводит private=… public=… (формат Xray менялся: Public key / Password)
  local out; out="$("$BIN/eskadra-xray" x25519)"
  local priv pub
  priv="$(printf '%s\n' "$out" | sed -nE 's/^(Private key|PrivateKey):[[:space:]]*//p' | head -1)"
  pub="$(printf '%s\n' "$out" | sed -nE 's/^(Public key|Password|PublicKey):[[:space:]]*//p' | head -1)"
  [ -n "$priv" ] && [ -n "$pub" ] || die "cannot parse x25519 output"
  echo "private=$priv"; echo "public=$pub"
}

cmd_stats() {  # счётчики пользователей с обнулением (§16)
  "$BIN/eskadra-xray" api statsquery --server=127.0.0.1:10085 -pattern 'user>>>' -reset 2>/dev/null || echo '{}'
}

cmd_tls() {  # самоподписанный сертификат для Hysteria2 (sing-box); выводит sha256 сертификата для pinning
  local sni="$1" d="$ETC/sing-box/tls"
  [[ "$sni" =~ ^[A-Za-z0-9.-]{1,253}$ ]] || die "bad sni"
  install -d -m 750 "$d"
  if [ ! -s "$d/$sni.crt" ]; then
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 3650 \
      -subj "/CN=$sni" -addext "subjectAltName=DNS:$sni" -keyout "$d/$sni.key" -out "$d/$sni.crt" >/dev/null 2>&1
    chmod 600 "$d/$sni.key"
  fi
  echo "pin=$(openssl x509 -in "$d/$sni.crt" -outform der | sha256sum | cut -d' ' -f1)"
  echo "cert=$d/$sni.crt"; echo "key=$d/$sni.key"
}

# ───── сертификаты TLS для inbounds: /etc/eskadra/tls/<имя>/{fullchain,privkey}.pem ─────
CB="$LIB/certbot/bin/certbot"
LEDIR="$ETC/letsencrypt"
cb() { "$CB" --config-dir "$LEDIR" --work-dir "$LEDIR/work" --logs-dir /var/log/eskadra-letsencrypt "$@"; }

ensure_certbot() {  # certbot ≥ 5.4 (сертификаты на IP) в своём venv; системный certbot не трогаем
  if [ -x "$CB" ] && "$CB" --version 2>/dev/null | awk '{split($2,v,"."); exit !(v[1]>5 || (v[1]==5 && v[2]>=4))}'; then return; fi
  local py=""
  for c in $(compgen -c python3 | grep -E '^python3(\.[0-9]+)?$' | sort -t. -k2,2nr -u); do
    "$c" -c 'import sys, venv, ensurepip; sys.exit(sys.version_info < (3, 9))' 2>/dev/null && { py="$(command -v "$c")"; break; }
  done
  if [ -z "$py" ]; then
    if command -v apt-get >/dev/null; then
      export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a NEEDRESTART_SUSPEND=1
      apt-get -o DPkg::Lock::Timeout=600 update -qq >/dev/null 2>&1 || true
      apt-get -o DPkg::Lock::Timeout=600 install -y -qq python3-venv >/dev/null 2>&1 \
        || apt-get -o DPkg::Lock::Timeout=600 install -y -qq "python$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')-venv" >/dev/null 2>&1 || true
    elif command -v dnf >/dev/null; then dnf install -y -q python3.12 >/dev/null 2>&1 || dnf install -y -q python3.11 >/dev/null 2>&1 || true
    elif command -v zypper >/dev/null; then zypper --non-interactive -q install python311 >/dev/null 2>&1 || true
    elif command -v pacman >/dev/null; then pacman -Sy --noconfirm --needed python >/dev/null 2>&1 || true; fi
    for c in $(compgen -c python3 | grep -E '^python3(\.[0-9]+)?$' | sort -t. -k2,2nr -u); do
      "$c" -c 'import sys, venv, ensurepip; sys.exit(sys.version_info < (3, 9))' 2>/dev/null && { py="$(command -v "$c")"; break; }
    done
  fi
  [ -n "$py" ] || die "нужен Python ≥ 3.9 с venv для certbot"
  rm -rf "$LIB/certbot"
  "$py" -m venv "$LIB/certbot" || die "не удалось создать окружение для certbot"
  "$LIB/certbot/bin/pip" install -q --disable-pip-version-check 'certbot>=5.4' >/dev/null 2>&1 || die "certbot не установился"
}

cert_hooks() {  # порт 80 на время выпуска/продления: правило в нашей таблице nft и в ufw/firewalld, если они включены
  install -d -m 755 "$ETC/tls/hooks"
  cat > "$ETC/tls/hooks/pre.sh" <<'EOF'
#!/bin/sh
nft list table inet fleet >/dev/null 2>&1 && nft insert rule inet fleet input tcp dport 80 accept comment '"eskadra-acme"' 2>/dev/null
if command -v ufw >/dev/null && ufw status | grep -q "^Status: active"; then ufw allow 80/tcp comment "eskadra acme" >/dev/null; fi
if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then firewall-cmd -q --add-port=80/tcp; fi
exit 0
EOF
  cat > "$ETC/tls/hooks/post.sh" <<'EOF'
#!/bin/sh
for h in $(nft -a list chain inet fleet input 2>/dev/null | sed -n 's/.*eskadra-acme.*# handle \([0-9]*\).*/\1/p'); do nft delete rule inet fleet input handle "$h"; done
if command -v ufw >/dev/null && ufw status | grep -q "^Status: active"; then ufw delete allow 80/tcp >/dev/null 2>&1 || true; fi
if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then firewall-cmd -q --remove-port=80/tcp || true; fi
exit 0
EOF
  chmod 755 "$ETC/tls/hooks/pre.sh" "$ETC/tls/hooks/post.sh"
}

cert_timer() {  # продление дважды в сутки; новый сертификат — в каталог tls и перезапуск ядер, которые его используют
  cat > "$UNITS/eskadra-certbot.service" <<EOF
[Unit]
Description=Eskadra: renew TLS certificates of inbounds
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fleet-core cert-renew
EOF
  cat > "$UNITS/eskadra-certbot.timer" <<'EOF'
[Unit]
Description=Eskadra: renew TLS certificates twice a day
[Timer]
OnCalendar=*-*-* 00,12:00:00
RandomizedDelaySec=1h
Persistent=true
[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload
  systemctl enable --now eskadra-certbot.timer >/dev/null 2>&1 || true
}

cmd_cert_renew() {  # продление (таймер и кнопка в панели): результат — в renew.status, его читает панель
  local out code=0
  [ -x "$CB" ] || { echo "certbot не установлен"; return 0; }
  [ -f "$UNITS/eskadra-certbot.timer" ] && ! systemctl is-active --quiet eskadra-certbot.timer && systemctl enable --now eskadra-certbot.timer >/dev/null 2>&1 || true
  out="$("$CB" --config-dir "$LEDIR" --work-dir "$LEDIR/work" --logs-dir /var/log/eskadra-letsencrypt renew -q 2>&1)" || code=$?
  install -d -m 755 "$ETC/tls"
  { echo "at=$(date +%s)"; echo "code=$code"
    echo "err=$(printf '%s' "$out" | grep -v '^\s*$' | tail -n 3 | tr '\n' ' ' | tr -d '\r' | cut -c1-400)"; } > "$ETC/tls/renew.status.new"
  mv "$ETC/tls/renew.status.new" "$ETC/tls/renew.status"
  [ "$code" = 0 ] && echo "renew ok" || { echo "renew failed: $out" >&2; return "$code"; }
}

cmd_cert_status() {  # сертификаты узла для панели: имя, конец срока (unix), Let's Encrypt ли он; результат последнего продления
  local f name end le
  # старый таймер вызывал certbot напрямую и не записывал результат — переводим на cert-renew
  if [ -f "$UNITS/eskadra-certbot.service" ] && ! grep -q 'cert-renew' "$UNITS/eskadra-certbot.service"; then cert_timer; fi
  for f in "$ETC"/tls/*/fullchain.pem; do
    [ -s "$f" ] || continue
    name="$(basename "$(dirname "$f")")"
    end="$(date -d "$(openssl x509 -in "$f" -noout -enddate | cut -d= -f2)" +%s 2>/dev/null || echo 0)"
    [ -f "$LEDIR/renewal/$name.conf" ] && le=1 || le=0
    echo "cert $name $end $le"
  done
  [ -f "$ETC/tls/renew.status" ] && sed 's/^/renew_/' "$ETC/tls/renew.status"
  systemctl is-active --quiet eskadra-certbot.timer 2>/dev/null && echo "timer=active" || echo "timer=inactive"
}

cmd_cert_deploy() {  # deploy-hook certbot: живой сертификат → /etc/eskadra/tls/<имя>, перезапуск ядер с этим сертификатом
  local name="$1" live="$LEDIR/live/$1" d="$ETC/tls/$1" core
  [ -s "$live/fullchain.pem" ] || die "нет сертификата $name"
  install -d -m 750 "$d"
  install -m 644 "$live/fullchain.pem" "$d/fullchain.pem.new" && mv "$d/fullchain.pem.new" "$d/fullchain.pem"
  install -m 600 "$live/privkey.pem" "$d/privkey.pem.new" && mv "$d/privkey.pem.new" "$d/privkey.pem"
  for core in xray sing-box; do
    grep -qs "/tls/$name/" "$(cfg_of "$core")" && systemctl is-active --quiet "$(unit_of "$core")" && systemctl restart "$(unit_of "$core")" || true
  done
  echo "deployed $name"
}

cmd_cert_issue() {  # cert-issue <имя> ip|domain <значение>: выпуск, если сертификата нет или он скоро истекает
  local name="$1" kind="$2" value="$3" args=() holder
  case "$kind" in
    ip) python3 -c 'import ipaddress,sys; ipaddress.ip_address(sys.argv[1])' "$value" 2>/dev/null || die "bad ip" ;;
    domain) [[ "$value" =~ ^[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || die "bad domain" ;;
    *) die "kind: ip|domain" ;;
  esac
  if [ -s "$ETC/tls/$name/fullchain.pem" ] && openssl x509 -in "$ETC/tls/$name/fullchain.pem" -noout -checkend 172800 >/dev/null 2>&1; then
    echo "cert $name: действует до $(openssl x509 -in "$ETC/tls/$name/fullchain.pem" -noout -enddate | cut -d= -f2)"; return 0
  fi
  holder="$(ss -ltnpH 'sport = :80' 2>/dev/null | head -1)"
  [ -z "$holder" ] || die "порт 80 занят ($(echo "$holder" | grep -o 'users:(("[^"]*"' | cut -d'"' -f2)) — Let's Encrypt не сможет проверить сервер; освободите порт 80 или используйте загруженный сертификат"
  ensure_certbot
  cert_hooks
  args=(certonly -q --standalone --non-interactive --agree-tos --register-unsafely-without-email --cert-name "$name" --key-type ecdsa
        --pre-hook "$ETC/tls/hooks/pre.sh" --post-hook "$ETC/tls/hooks/post.sh" --deploy-hook "/usr/local/sbin/fleet-core cert-deploy $name")
  if [ "$kind" = ip ]; then args+=(--preferred-profile shortlived --ip-address "$value"); else args+=(-d "$value"); fi
  cb "${args[@]}" || die "Let's Encrypt не выдал сертификат для $value (порт 80 должен быть открыт снаружи, в т. ч. в firewall хостера)"
  if [ "$kind" = ip ]; then  # 6-дневный сертификат продлеваем за 3 дня
    local rc="$LEDIR/renewal/$name.conf"
    grep -q '^renew_before_expiry' "$rc" && sed -i 's/^renew_before_expiry.*/renew_before_expiry = 3 days/' "$rc" || sed -i '1a renew_before_expiry = 3 days' "$rc"
  fi
  [ -s "$ETC/tls/$name/fullchain.pem" ] || cmd_cert_deploy "$name" >/dev/null
  cert_timer
  echo "cert $name: выпущен Let's Encrypt для $value"
}

cmd_cert_set() {  # cert-set <имя> <fullchain> <privkey>: загруженный сертификат
  local name="$1" crt="$2" key="$3" d="$ETC/tls/$1" a b
  openssl x509 -in "$crt" -noout >/dev/null 2>&1 || die "это не сертификат PEM"
  a="$(openssl x509 -in "$crt" -noout -pubkey | sha256sum)"; b="$(openssl pkey -in "$key" -pubout 2>/dev/null | sha256sum)"
  [ "$a" = "$b" ] || die "ключ не подходит к сертификату"
  install -d -m 750 "$d"
  if cmp -s "$crt" "$d/fullchain.pem" && cmp -s "$key" "$d/privkey.pem"; then echo "cert $name: без изменений"; return 0; fi
  install -m 644 "$crt" "$d/fullchain.pem.new" && mv "$d/fullchain.pem.new" "$d/fullchain.pem"
  install -m 600 "$key" "$d/privkey.pem.new" && mv "$d/privkey.pem.new" "$d/privkey.pem"
  echo "cert $name: установлен, действует до $(openssl x509 -in "$d/fullchain.pem" -noout -enddate | cut -d= -f2)"
}

case "${1:-}" in
  install) cmd_install "${2:?}" "${3:?}" "${4:?}" ;;
  rollback) cmd_rollback "${2:?}" ;;
  apply)   cmd_apply "${2:?}" "${3:?}" ;;
  status)  cmd_status "${2:?}" ;;
  stop)    systemctl disable --now "$(unit_of "${2:?}")" 2>/dev/null || true; echo stopped ;;
  start)   [ -s "$(cfg_of "${2:?}")" ] || die "у $2 нет конфига — выкатите конфигурацию"
           systemctl enable --now "$(unit_of "$2")" >/dev/null 2>&1 || die "$2 не запустился: $(systemctl status "$(unit_of "$2")" 2>&1 | tail -3)"
           sleep 1; systemctl is-active --quiet "$(unit_of "$2")" || die "$2 не запустился: $(journalctl -u "$(unit_of "$2")" -n 3 --no-pager 2>/dev/null)"; echo started ;;
  x25519)  cmd_x25519 ;;
  hoststat) cmd_hoststat ;;
  probe)   cmd_probe "${2:?}" "${3:?}" ;;
  bo)      cmd_bo "${2:?}" "${3:?}" ;;
  stats)   cmd_stats ;;
  tls)     cmd_tls "${2:?}" ;;
  cert-issue)  cmd_cert_issue "${2:?}" "${3:?}" "${4:?}" ;;
  cert-set)    cmd_cert_set "${2:?}" "${3:?}" "${4:?}" ;;
  cert-deploy) cmd_cert_deploy "${2:?}" ;;
  cert-renew)  cmd_cert_renew ;;
  cert-status) cmd_cert_status ;;
  *) die "usage: fleet-core install|apply|status|stop|x25519|stats|tls" ;;
esac
