#!/usr/bin/env bash
# eskadra — терминальное управление «Эскадрой» на главном сервере.
#   eskadra            интерактивное меню (флот + панель)
#   eskadra <команда>  то же без меню (eskadra help — список)
set -euo pipefail

PREFIX=/opt/eskadra
ETC=/etc/eskadra
DATA=/var/lib/eskadra
ENVF="$ETC/eskadra.env"
NODE="$PREFIX/node/bin/node"
APP="$PREFIX/app/server/dist"
CERTBOT="$PREFIX/certbot/bin/certbot"

c_ok=$'\e[32m'; c_warn=$'\e[33m'; c_err=$'\e[31m'; c_b=$'\e[1m'; c_dim=$'\e[2m'; c_acc=$'\e[38;5;179m'; c_0=$'\e[0m'
die()  { printf '%s\n' "${c_err}✗ $*${c_0}" >&2; exit 1; }
ok()   { printf '%s\n' "${c_ok}✓${c_0} $*"; }
warn() { printf '%s\n' "${c_warn}!${c_0} $*"; }

[ "$(id -u)" -eq 0 ] || die "запустите под root: sudo eskadra"
[ -f "$ENVF" ] || die "Эскадра не установлена ($ENVF нет)"

# Ввод работает и при запуске из «bash <(curl …)»; без терминала берётся значение по умолчанию.
prompt() {  # prompt "вопрос" [по умолчанию]
  local a=""
  if [ -r /dev/tty ]; then read -r -p "$1 " a < /dev/tty || true; fi
  printf '%s' "${a:-${2:-}}"
}
yes_no() { [[ "$(prompt "$1 [y/N]:" n)" =~ ^(y|Y|д|Д|yes|да)$ ]]; }

getenv() { grep -E "^$1=" "$ENVF" | tail -1 | cut -d= -f2- || true; }
setenv() { if grep -qE "^$1=" "$ENVF"; then sed -i "s|^$1=.*|$1=$2|" "$ENVF"; else echo "$1=$2" >> "$ENVF"; fi; }
envline() { grep -v '^#' "$ENVF" | xargs; }
cli() { runuser -u eskadra -- env $(envline) "$NODE" "$APP/cli.js" "$@"; }
tui() { runuser -u eskadra -- env $(envline) "$NODE" "$APP/tui.js" "$@"; }

public_ip() {
  local ip; ip="$(cli executor 2>/dev/null | cut -d, -f1)"
  [ -n "$ip" ] || ip="$(curl -4fsS --max-time 6 https://api.ipify.org 2>/dev/null || hostname -I | awk '{print $1}')"
  echo "$ip"
}
public_host() { local h; h="$(getenv FLEET_PUBLIC_HOST)"; [ -n "$h" ] && echo "$h" || public_ip; }

ufw_on() { command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; }
firewalld_on() { command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; }
ufw_swap() {  # ufw_swap OLD NEW COMMENT — открыть новый порт и закрыть старый в firewall хоста (ufw или firewalld)
  if ufw_on; then
    [ -n "$1" ] && ufw delete allow "$1/tcp" >/dev/null 2>&1 || true
    ufw allow "$2/tcp" comment "$3" >/dev/null && ok "ufw: порт $2 открыт${1:+, $1 закрыт}"
  fi
  if firewalld_on; then
    [ -n "$1" ] && firewall-cmd -q --permanent --remove-port="$1/tcp" 2>/dev/null || true
    firewall-cmd -q --permanent --add-port="$2/tcp" && firewall-cmd -q --reload && ok "firewalld: порт $2 открыт${1:+, $1 закрыт}"
  fi
}

pm() {
  if command -v apt-get >/dev/null; then echo apt; elif command -v dnf >/dev/null; then echo dnf
  elif command -v yum >/dev/null; then echo yum; elif command -v zypper >/dev/null; then echo zypper
  elif command -v pacman >/dev/null; then echo pacman; else echo none; fi
}
pkg_add() {  # pkg_add <пакет> — установить пакетным менеджером системы
  case "$(pm)" in
    apt) DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=600 install -y -qq "$@" >/dev/null ;;
    dnf) dnf install -y -q "$@" >/dev/null ;;
    yum) yum install -y -q "$@" >/dev/null ;;
    zypper) zypper --non-interactive --quiet install "$@" >/dev/null ;;
    pacman) pacman -Sy --noconfirm --needed "$@" >/dev/null ;;
    *) return 1 ;;
  esac
}

restart() { systemctl restart eskadra; sleep 2; systemctl is-active --quiet eskadra && ok "панель перезапущена" || { journalctl -u eskadra -n 20 --no-pager; die "панель не запустилась"; }; }

sub_port() { cli status | sed -n 's/.*"subPort":\([0-9]*\).*/\1/p'; }

# ───────────────────────── адрес и состояние ─────────────────────────

cmd_url() {
  local url fp issuer st
  url="https://$(public_host):$(getenv FLEET_PORT)$(getenv FLEET_BASE_PATH)"
  fp="$(openssl x509 -in "$(getenv FLEET_TLS_CERT)" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2)"
  issuer="$(openssl x509 -in "$(getenv FLEET_TLS_CERT)" -noout -issuer 2>/dev/null)"
  st="$(cli status)"
  if [[ "$st" == *'"admins":0'* ]]; then
    printf '\n  %sСоздание владельца (ссылка одноразовая):%s\n  %s%s#/setup?token=%s%s\n' "$c_b" "$c_0" "$c_acc" "$url" "$(cli setup-token)" "$c_0"
  else
    printf '\n  %sПанель:%s %s%s%s\n' "$c_b" "$c_0" "$c_acc" "$url" "$c_0"
  fi
  if [[ "$issuer" == *"Let's Encrypt"* ]]; then
    printf '  %sСертификат Let'"'"'s Encrypt, действует до %s%s\n' "$c_dim" "$(openssl x509 -in "$(getenv FLEET_TLS_CERT)" -noout -enddate | cut -d= -f2)" "$c_0"
  else
    printf '  %sСамоподписанный сертификат. Отпечаток SHA-256 (сверьте в браузере):%s\n  %s\n' "$c_dim" "$c_0" "$fp"
    printf '  %sВыпустить Let'"'"'s Encrypt: eskadra cert letsencrypt%s\n' "$c_dim" "$c_0"
  fi
}

cmd_status() {
  local st active
  active="$(systemctl is-active eskadra 2>/dev/null || true)"
  st="$(cli status 2>/dev/null || echo '{}')"
  printf '\n  %s⛵ Эскадра%s  %s   версия %s\n' "$c_acc$c_b" "$c_0" "$( [ "$active" = active ] && echo "${c_ok}● работает${c_0}" || echo "${c_err}● $active${c_0}")" "$(cat "$PREFIX/app/VERSION" 2>/dev/null || echo '?')"
  printf '  %sпанель :%s · подписки :%s · серверов %s (без связи %s) · пользователей %s%s\n' "$c_dim" \
    "$(getenv FLEET_PORT)" "$(sed -n 's/.*"subPort":\([0-9]*\).*/\1/p' <<<"$st")" \
    "$(sed -n 's/.*"servers":\([0-9]*\).*/\1/p' <<<"$st")" "$(sed -n 's/.*"offline":\([0-9]*\).*/\1/p' <<<"$st")" \
    "$(sed -n 's/.*"users":\([0-9]*\).*/\1/p' <<<"$st")" "$c_0"
}

# ───────────────────────── порты и путь ─────────────────────────

rand_port() {
  local p
  for _ in $(seq 1 50); do
    p=$(( (RANDOM << 15 | RANDOM) % 50000 + 10000 ))
    case "$p" in 10085|51820|2053|2096|54321) continue ;; esac
    ss -ltnH "sport = :$p" 2>/dev/null | grep -q . || { echo "$p"; return; }
  done
  die "не нашёл свободный порт"
}

cmd_port() {
  local old new="${1:-}"
  old="$(getenv FLEET_PORT)"
  [ -n "$new" ] || new="$(prompt "Новый порт панели (Enter — случайный):")"
  [ -z "$new" ] || [ "$new" = random ] && new="$(rand_port)"
  [[ "$new" =~ ^[0-9]+$ ]] && [ "$new" -ge 1024 ] && [ "$new" -le 65535 ] || die "порт 1024–65535"
  ss -ltnH "sport = :$new" | grep -q . && die "порт $new занят"
  setenv FLEET_PORT "$new"; ufw_swap "$old" "$new" "eskadra panel"; restart; cmd_url
}

cmd_path() {
  local new="${1:-}"
  [ -n "$new" ] || new="$(prompt "Новый путь (Enter — случайный):")"
  [ -n "$new" ] || new="$(tr -dc 'a-z0-9' < /dev/urandom | head -c 12)"
  [[ "$new" =~ ^[A-Za-z0-9_-]+$ ]] || die "путь: латиница, цифры, - и _"
  setenv FLEET_BASE_PATH "/$new/"; restart; cmd_url
}

cmd_sub_port() {
  local old new="${1:-}"
  old="$(sub_port)"
  [ -n "$new" ] || new="$(prompt "Новый порт подписок (Enter — случайный):")"
  [ -n "$new" ] || new=random
  new="$(cli sub-port "$new")"
  ufw_swap "$old" "$new" "eskadra subscriptions"; restart
  ok "порт подписок: $new. Старые ссылки подписок перестанут работать — пользователям нужно обновить ссылку."
}

cmd_reset_password() {
  local r; r="$(cli reset-password "${1:-}")"
  printf '\n  Логин: %s%s%s\n  Новый пароль: %s%s%s\n  %sПароль показан один раз. Все сессии этого администратора завершены.%s\n' \
    "$c_b" "${r%% *}" "$c_0" "$c_acc" "${r#* }" "$c_0" "$c_dim" "$c_0"
}

# ───────────────────────── сертификаты ─────────────────────────

venv_python() {  # Python ≥ 3.9 с рабочим venv (certbot 5.x не ставится на 3.6 из RHEL 8)
  local py
  for py in python3.13 python3.12 python3.11 python3.10 python3.9 python3; do
    command -v "$py" >/dev/null || continue
    "$py" -c 'import sys, venv, ensurepip; sys.exit(sys.version_info < (3, 9))' 2>/dev/null && { command -v "$py"; return 0; }
  done
  return 1
}

ensure_certbot() {
  # сертификаты на IP требуют certbot ≥ 5.3 (в репозиториях дистрибутивов он старее) — ставим в отдельный venv
  if [ -x "$CERTBOT" ] && "$CERTBOT" --version 2>/dev/null | awk '{split($2,v,"."); exit !(v[1]>5 || (v[1]==5 && v[2]>=4))}'; then return; fi
  echo "  ставлю certbot…"
  local py
  if ! py="$(venv_python)"; then
    case "$(pm)" in
      apt) pkg_add python3-venv ;;
      dnf|yum) pkg_add python3.11 || pkg_add python39 ;;   # RHEL 8: системный python3 — 3.6
      zypper) pkg_add python311 || pkg_add python3 ;;
      pacman) pkg_add python ;;
    esac || true
    py="$(venv_python)" || die "нужен Python ≥ 3.9 с модулем venv — установите его и повторите"
  fi
  rm -rf "$PREFIX/certbot"
  "$py" -m venv "$PREFIX/certbot"
  "$PREFIX/certbot/bin/pip" install -q --upgrade pip >/dev/null
  "$PREFIX/certbot/bin/pip" install -q 'certbot>=5.4' >/dev/null
  "$CERTBOT" --version >/dev/null || die "certbot не установился"
}

write_hooks() {  # write_hooks <unit, который держит :80, или пусто>
  install -d -m 755 "$ETC/hooks"
  {
    echo '#!/bin/sh'
    echo '# перед выпуском/продлением: открыть порт 80 на ~30 с (ACME HTTP-01)'
    [ -n "$1" ] && echo "systemctl stop $1"
    echo 'if command -v ufw >/dev/null && ufw status | grep -q "^Status: active"; then ufw allow 80/tcp comment "eskadra acme" >/dev/null; fi'
    echo 'if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then firewall-cmd -q --add-port=80/tcp; fi'
  } > "$ETC/hooks/pre.sh"
  {
    echo '#!/bin/sh'
    echo 'if command -v ufw >/dev/null && ufw status | grep -q "^Status: active"; then ufw delete allow 80/tcp >/dev/null 2>&1 || true; fi'
    echo 'if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then firewall-cmd -q --remove-port=80/tcp || true; fi'
    [ -n "$1" ] && echo "systemctl start $1"
    echo 'exit 0'
  } > "$ETC/hooks/post.sh"
  chmod 755 "$ETC/hooks/pre.sh" "$ETC/hooks/post.sh"
}

install_renew_timer() {
  cat > /etc/systemd/system/eskadra-certbot.service <<EOF
[Unit]
Description=Eskadra: renew Let's Encrypt certificate
[Service]
Type=oneshot
ExecStart=$CERTBOT renew -q
EOF
  cat > /etc/systemd/system/eskadra-certbot.timer <<'EOF'
[Unit]
Description=Eskadra: renew Let's Encrypt certificate twice a day
[Timer]
OnCalendar=*-*-* 00,12:00:00
RandomizedDelaySec=1h
Persistent=true
[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload
  systemctl enable --now eskadra-certbot.timer >/dev/null
}

cmd_cert_deploy() {  # deploy-hook certbot: новый сертификат → панель (она перечитывает его сама)
  local live=/etc/letsencrypt/live/eskadra
  [ -s "$live/fullchain.pem" ] || die "нет сертификата Let's Encrypt"
  install -o eskadra -g eskadra -m 644 "$live/fullchain.pem" "$DATA/tls/cert.pem.new"
  install -o eskadra -g eskadra -m 600 "$live/privkey.pem" "$DATA/tls/key.pem.new"
  mv "$DATA/tls/key.pem.new" "$DATA/tls/key.pem"
  mv "$DATA/tls/cert.pem.new" "$DATA/tls/cert.pem"
}

cmd_letsencrypt() {  # cmd_letsencrypt [ip|domain] [домен]
  local kind="${1:-}" domain="${2:-}" ip holder pid unit="" email args=()
  ip="$(public_ip)"
  if [ -z "$kind" ]; then
    printf '\n  %sСертификат Let'"'"'s Encrypt%s\n' "$c_b" "$c_0"
    printf '   1) На IP %s — без домена, сертификат на 6 дней, продлевается сам\n' "$ip"
    printf '   2) На домен — нужен домен с A-записью на %s, сертификат на 90 дней\n' "$ip"
    case "$(prompt "  Выберите [1]:" 1)" in 2) kind=domain ;; *) kind=ip ;; esac
  fi
  if [ "$kind" = domain ]; then
    [ -n "$domain" ] || domain="$(prompt "  Домен:")"
    [[ "$domain" =~ ^[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || die "неверный домен"
    local resolved; resolved="$(getent ahostsv4 "$domain" | awk 'NR==1{print $1}')"
    [ "$resolved" = "$ip" ] || warn "домен $domain указывает на ${resolved:-ничто}, а сервер — $ip. Выпуск, скорее всего, не пройдёт."
  fi

  # порт 80 нужен валидатору Let's Encrypt (HTTP-01) на время выпуска и каждого продления
  holder="$(ss -ltnpH 'sport = :80' 2>/dev/null | sed -n 's/.*users:(("\([^"]*\)",pid=\([0-9]*\).*/\1 \2/p' | head -1)"
  if [ -n "$holder" ]; then
    pid="${holder#* }"; unit="$(ps -o unit= -p "$pid" 2>/dev/null | tr -d ' ')"
    warn "порт 80 занят: ${holder% *}${unit:+ ($unit)}"
    [ -n "$unit" ] && [[ "$unit" == *.service ]] || die "не удалось определить сервис на порту 80 — освободите порт и повторите"
    yes_no "  Останавливать $unit на ~30 с при выпуске и каждом продлении?" || die "без порта 80 сертификат Let's Encrypt не выпустить"
  fi
  printf '  Выпуск означает согласие с условиями Let'"'"'s Encrypt: https://letsencrypt.org/repository/\n'
  [[ "$(prompt "  Согласны? [Y/n]:" y)" =~ ^(n|N|н|Н)$ ]] && die "отменено"
  email="$(prompt "  Email для уведомлений Let's Encrypt (Enter — без email):")"

  ensure_certbot
  write_hooks "$unit"
  "$CERTBOT" delete --cert-name eskadra --non-interactive >/dev/null 2>&1 || true
  args=(certonly --standalone --non-interactive --agree-tos --cert-name eskadra --key-type ecdsa
        --pre-hook "$ETC/hooks/pre.sh" --post-hook "$ETC/hooks/post.sh" --deploy-hook "/usr/local/bin/eskadra cert-deploy")
  if [ -n "$email" ]; then args+=(-m "$email"); else args+=(--register-unsafely-without-email); fi
  if [ "$kind" = ip ]; then args+=(--preferred-profile shortlived --ip-address "$ip"); else args+=(-d "$domain"); fi
  echo "  выпускаю сертификат…"
  "$CERTBOT" "${args[@]}" || die "Let's Encrypt не выдал сертификат (см. вывод выше). Панель продолжает работать со старым сертификатом."
  if [ "$kind" = ip ]; then
    # 6-дневный сертификат: продлевать за 3 дня до окончания (таймер проверяет дважды в сутки)
    local rc=/etc/letsencrypt/renewal/eskadra.conf
    grep -q '^renew_before_expiry' "$rc" && sed -i 's/^renew_before_expiry.*/renew_before_expiry = 3 days/' "$rc" || sed -i '1a renew_before_expiry = 3 days' "$rc"
  fi
  cmd_cert_deploy
  install_renew_timer
  local host; if [ "$kind" = domain ]; then host="$domain"; else host="$ip"; fi
  setenv FLEET_PUBLIC_HOST "$host"
  setenv FLEET_SUB_TLS 1
  cli sub-port "$(sub_port)" "$host" >/dev/null
  restart
  ok "сертификат Let's Encrypt установлен на $host, продление — автоматически"
  warn "подписки теперь отдаются по HTTPS: ссылки пользователей сменились на https://$host:$(sub_port)/…"
  cmd_url
}

cmd_selfsigned() {
  local ip; ip="$(public_ip)"
  openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 3650 -subj "/CN=$ip" \
    -addext "subjectAltName=IP:$ip" -keyout "$DATA/tls/key.pem" -out "$DATA/tls/cert.pem" >/dev/null 2>&1
  chown eskadra:eskadra "$DATA/tls/"*.pem; chmod 600 "$DATA/tls/key.pem"
  systemctl disable --now eskadra-certbot.timer >/dev/null 2>&1 || true
  setenv FLEET_SUB_TLS 0; setenv FLEET_PUBLIC_HOST "$ip"
  restart; cmd_url
}

cmd_cert() {
  case "${1:-show}" in
    show) openssl x509 -in "$(getenv FLEET_TLS_CERT)" -noout -subject -issuer -enddate -fingerprint -sha256
          systemctl is-active --quiet eskadra-certbot.timer && echo "автопродление: включено ($(systemctl show eskadra-certbot.timer -p NextElapseUSecRealtime --value))" || true ;;
    letsencrypt|le) shift; cmd_letsencrypt "${1:-}" "${2:-}" ;;
    selfsigned) cmd_selfsigned ;;
    set)
      [ -f "${2:-}" ] && [ -f "${3:-}" ] || die "eskadra cert set <fullchain.pem> <privkey.pem>"
      install -o eskadra -g eskadra -m 644 "$2" "$DATA/tls/cert.pem"; install -o eskadra -g eskadra -m 600 "$3" "$DATA/tls/key.pem"
      restart ;;
    *) die "eskadra cert show | letsencrypt [ip|domain <домен>] | selfsigned | set <cert> <key>" ;;
  esac
}

menu_cert() {
  printf '\n'; cmd_cert show || true
  printf '\n   1) Let'"'"'s Encrypt на IP\n   2) Let'"'"'s Encrypt на домен\n   3) Самоподписанный\n   0) Назад\n'
  case "$(prompt "  Выберите:")" in 1) cmd_letsencrypt ip ;; 2) cmd_letsencrypt domain ;; 3) cmd_selfsigned ;; esac
}

# ───────────────────────── конфликты ядер на этом сервере ─────────────────────────

xui_present() { [ -d /usr/local/x-ui ] || [ -d /etc/x-ui ] || systemctl cat x-ui.service >/dev/null 2>&1; }

remove_xui() {
  local d; d="$DATA/backup"; install -d -m 700 "$d"
  local f; f="$d/x-ui-$(date -u +%Y%m%dT%H%M%SZ).tar.gz"
  tar -czf "$f" /etc/x-ui /usr/local/x-ui/bin/config.json 2>/dev/null || true
  systemctl disable --now x-ui 2>/dev/null || true
  rm -rf /usr/local/x-ui /etc/x-ui
  rm -f /etc/systemd/system/x-ui.service /usr/bin/x-ui
  systemctl daemon-reload
  ok "3x-ui удалён. База и конфиг сохранены: $f"
}

# «Удалить или дополнить»: решает, что делать с уже установленными ядрами, чтобы не было конфликта
cmd_conflicts() {
  local choice found=0
  if xui_present; then
    found=1
    local v; v="$(/usr/local/x-ui/x-ui -v 2>/dev/null | head -1 || true)"
    printf '\n  %sНайден 3x-ui%s %s (%s)\n' "$c_b" "$c_0" "$v" "$(systemctl is-active x-ui 2>/dev/null || echo '?')"
    printf '   1) Дополнить — оставить 3x-ui. Если добавить этот сервер как узел, Эскадра положит свои inbounds\n'
    printf '      в Xray 3x-ui и не запустит второй Xray. Пользователи 3x-ui продолжат работать.\n'
    printf '   2) Удалить 3x-ui — база и конфиг сохранятся в %s/backup, Эскадра поставит своё ядро.\n' "$DATA"
    printf '      Пользователи 3x-ui потеряют доступ.\n'
    choice="${ESKADRA_XUI:-}"
    [ -n "$choice" ] || choice="$(prompt "  Выберите [1]:" 1)"
    case "$choice" in
      2|remove) yes_no "  Точно удалить 3x-ui?" && remove_xui || ok "3x-ui оставлен" ;;
      *) ok "3x-ui оставлен — Эскадра будет его дополнять" ;;
    esac
  fi
  for svc in xray sing-box v2ray hysteria-server; do
    systemctl is-active --quiet "$svc" 2>/dev/null || continue
    found=1
    printf '\n  %sРаботает %s.service%s (не 3x-ui)\n' "$c_b" "$svc" "$c_0"
    printf '   1) Оставить — Эскадра не запустит своё ядро этого типа на этом сервере\n'
    printf '   2) Остановить и отключить — файлы не удаляются, Эскадра поставит своё ядро\n'
    case "$(prompt "  Выберите [1]:" 1)" in
      2) systemctl disable --now "$svc" && ok "$svc остановлен и отключён" ;;
      *) ok "$svc оставлен" ;;
    esac
  done
  [ "$found" = 1 ] || ok "сторонних VPN-ядер на этом сервере нет"
}

# ───────────────────────── обслуживание ─────────────────────────

cmd_update() {
  local repo; repo="$(cat "$PREFIX/app/REPO" 2>/dev/null || true)"
  [ -n "$repo" ] || die "неизвестен репозиторий релизов"
  ESKADRA_REPO="$repo" ESKADRA_VERSION="${1:-latest}" bash <(curl -fsSL "https://raw.githubusercontent.com/$repo/main/scripts/install.sh")
}

cmd_uninstall() {
  yes_no "Удалить Эскадру? Данные в $DATA сохранятся." || exit 0
  systemctl disable --now eskadra eskadra-certbot.timer 2>/dev/null || true
  rm -f /etc/systemd/system/eskadra.service /etc/systemd/system/eskadra-certbot.* /usr/local/bin/eskadra
  rm -rf "$PREFIX"
  systemctl daemon-reload
  ok "удалено. Данные и настройки: $DATA, $ETC, /etc/letsencrypt/live/eskadra (удалите вручную, если не нужны)"
}

usage() {
  cat <<EOF
Флот (интерактивно):
  fleet [раздел]          overview | servers | users | configs | cores | backups | audit
Панель:
  status | url | start | stop | restart | logs
  port [N|random]         порт панели (ufw обновится)
  path [имя]              секретный путь панели
  sub-port [N|random]     порт подписок
  cert [show|letsencrypt [ip|domain <домен>]|selfsigned|set <cert> <key>]
  conflicts               3x-ui / xray / sing-box на этом сервере: дополнить или удалить
  reset-password [логин]  новый пароль администратора
  disable-2fa <логин>     отключить 2FA
  admins | backup | update [версия] | uninstall
EOF
}

menu() {
  while true; do
    cmd_status
    cat <<EOF

  ${c_b}Флот${c_0}                          ${c_b}Панель${c_0}
   1) Обзор                       8) Адрес входа
   2) Серверы                     9) Сертификат (Let's Encrypt)
   3) Пользователи               10) Порт панели
   4) Конфигурации               11) Секретный путь
   5) Ядра                       12) Порт подписок
   6) Бэкапы                     13) Сбросить пароль / 2FA
   7) Аудит                      14) 3x-ui и другие ядра
                                 15) Перезапуск · 16) Логи
                                 17) Обновить · 18) Удалить
   0) Выход
EOF
    local c; c="$(prompt "  Выберите:")"
    case "$c" in
      1) tui overview || true ;;
      2) tui servers || true ;;
      3) tui users || true ;;
      4) tui configs || true ;;
      5) tui cores || true ;;
      6) tui backups || true ;;
      7) tui audit || true ;;
      8) cmd_url ;;
      9) menu_cert ;;
      10) cmd_port ;;
      11) cmd_path ;;
      12) cmd_sub_port ;;
      13) cli admins
          local u; u="$(prompt "  Логин (Enter — owner):")"
          case "$(prompt "  1) новый пароль  2) отключить 2FA [1]:" 1)" in 2) [ -n "$u" ] && cli disable-2fa "$u" ;; *) cmd_reset_password "$u" ;; esac ;;
      14) cmd_conflicts ;;
      15) restart ;;
      16) journalctl -u eskadra -n 60 --no-pager ;;
      17) cmd_update ;;
      18) cmd_uninstall ;;
      0|q|"") exit 0 ;;
      *) echo "  нет такого пункта" ;;
    esac
    [[ "$c" =~ ^[1-7]$ ]] || prompt "  Enter — назад в меню" >/dev/null
  done
}

case "${1:-menu}" in
  menu) menu ;;
  fleet) tui "${2:-}" ;;
  status) cmd_status ;;
  url) cmd_url ;;
  start) systemctl start eskadra && ok запущена ;;
  stop) systemctl stop eskadra && ok остановлена ;;
  restart) restart ;;
  logs) journalctl -u eskadra -n "${2:-100}" --no-pager ;;
  port) cmd_port "${2:-}" ;;
  path) cmd_path "${2:-}" ;;
  sub-port) cmd_sub_port "${2:-}" ;;
  cert) shift; cmd_cert "$@" ;;
  cert-deploy) cmd_cert_deploy ;;
  conflicts) cmd_conflicts ;;
  reset-password) cmd_reset_password "${2:-}" ;;
  disable-2fa) [ -n "${2:-}" ] || die "eskadra disable-2fa <логин>"; cli disable-2fa "$2" ;;
  admins) cli admins ;;
  backup) cli backup ;;
  update) cmd_update "${2:-}" ;;
  uninstall) cmd_uninstall ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
