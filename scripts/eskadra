#!/usr/bin/env bash
# eskadra — терминальное управление «Эскадрой» на главном сервере.
#   eskadra            интерактивное меню (флот + панель)
#   eskadra <команда>  то же без меню (eskadra help — список)
set -euo pipefail

PREFIX=/opt/eskadra
ETC=/etc/eskadra
DATA=/var/lib/eskadra
ENVF="$ETC/eskadra.env"
NODE="$PREFIX/node/bin/node"
APP="$PREFIX/app/server/dist"
CERTBOT="$PREFIX/certbot/bin/certbot"
# свой каталог certbot: системный certbot и сертификаты других сайтов на этом сервере его не видят, а он — их
LE="$ETC/letsencrypt"
LE_ARGS=(--config-dir "$LE" --work-dir "$LE/work" --logs-dir /var/log/eskadra-letsencrypt)

c_ok=$'\e[32m'; c_warn=$'\e[33m'; c_err=$'\e[31m'; c_b=$'\e[1m'; c_dim=$'\e[2m'; c_acc=$'\e[38;5;179m'; c_0=$'\e[0m'
die()  { printf '%s\n' "${c_err}✗ $*${c_0}" >&2; exit 1; }
ok()   { printf '%s\n' "${c_ok}✓${c_0} $*"; }
warn() { printf '%s\n' "${c_warn}!${c_0} $*"; }

[ "$(id -u)" -eq 0 ] || die "запустите под root: sudo eskadra"
[ -f "$ENVF" ] || die "Эскадра не установлена ($ENVF нет)"

# Ввод работает и при запуске из «bash <(curl …)»; без терминала берётся значение по умолчанию.
has_tty() { { : < /dev/tty; } 2>/dev/null; }   # [ -r /dev/tty ] истинно и без терминала (ssh без -t, cron)
prompt() {  # prompt "вопрос" [по умолчанию]
  local a="" _
  if has_tty; then
    # набранное до вопроса (лишний Enter, CR+LF из Windows-терминала) не должно стать ответом
    while read -r -t 0.05 _ < /dev/tty 2>/dev/null; do :; done
    read -r -p "$1 " a < /dev/tty || true
  fi
  a="${a//$'\r'/}"; a="${a#"${a%%[![:space:]]*}"}"; a="${a%"${a##*[![:space:]]}"}"
  printf '%s' "${a:-${2:-}}"
}
yes_no() { [[ "$(prompt "$1 [y/N]:" n)" =~ ^(y|Y|д|Д|yes|да)$ ]]; }

getenv() { grep -E "^$1=" "$ENVF" | tail -1 | cut -d= -f2- || true; }
setenv() { if grep -qE "^$1=" "$ENVF"; then sed -i "s|^$1=.*|$1=$2|" "$ENVF"; else echo "$1=$2" >> "$ENVF"; fi; }
envline() { grep -v '^#' "$ENVF" | xargs; }
cli() { runuser -u eskadra -- env $(envline) "$NODE" "$APP/cli.js" "$@"; }
tui() { runuser -u eskadra -- env $(envline) "$NODE" "$APP/tui.js" "$@"; }

# Каталог $DATA принадлежит eskadra — процесс панели может подложить в нём симлинк на любой системный файл.
# Поэтому root здесь ничего не открывает и не chown'ит в $DATA сам: чтение и запись идут от имени eskadra,
# и подложенный симлинк даёт панели ровно те права, что у неё уже есть.
as_panel() { runuser -u eskadra -- "$@"; }
panel_put() {  # panel_put ФАЙЛ РЕЖИМ < данные — атомарная замена файла от имени eskadra
  as_panel sh -c 'umask 077; t="$1.new.$$"; cat > "$t" && chmod "$2" "$t" && mv -f "$t" "$1"' _ "$1" "$2"
}
panel_log_reset() { as_panel sh -c 'umask 027; : > "$1"' _ "$1"; }
panel_log() { as_panel sh -c 'cat >> "$1"' _ "$1"; }   # panel_log ФАЙЛ < строки

public_ip() {
  local ip; ip="$(cli executor 2>/dev/null | cut -d, -f1)"
  [ -n "$ip" ] || ip="$(curl -4fsS --max-time 6 https://api.ipify.org 2>/dev/null || hostname -I | awk '{print $1}')"
  echo "$ip"
}
public_host() { local h; h="$(getenv FLEET_PUBLIC_HOST)"; [ -n "$h" ] && echo "$h" || public_ip; }
# Внешний IP именно этого сервера — для сертификата на IP и проверки домена. Не из базы: после переноса там
# могли остаться адреса прежнего сервера панели.
own_ip() {
  local ip
  ip="$(curl -4fsS --max-time 8 https://api.ipify.org 2>/dev/null || true)"
  [[ "$ip" =~ ^[0-9]+(\.[0-9]+){3}$ ]] || ip="$(ip -4 -o route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}')"
  [ -n "$ip" ] || ip="$(hostname -I | awk '{print $1}')"
  echo "$ip"
}
# Кто держит порт 80: «программа pid служба» (служба — пусто, если процесс не служба systemd). Свободен — пусто.
port80_holder() {
  local h pid unit
  h="$(ss -ltnpH 'sport = :80' 2>/dev/null | sed -n 's/.*users:(("\([^"]*\)",pid=\([0-9]*\).*/\1 \2/p' | head -1)"
  [ -n "$h" ] || return 0
  pid="${h#* }"; unit="$(ps -o unit= -p "$pid" 2>/dev/null | tr -d ' ')"
  [[ "$unit" == *.service ]] || unit=""
  echo "$h $unit"
}

ufw_on() { command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; }
firewalld_on() { command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; }
ufw_swap() {  # ufw_swap OLD NEW COMMENT — открыть новый порт и закрыть старый в firewall хоста (ufw или firewalld)
  if ufw_on; then
    [ -n "$1" ] && ufw delete allow "$1/tcp" >/dev/null 2>&1 || true
    ufw allow "$2/tcp" comment "$3" >/dev/null && ok "ufw: порт $2 открыт${1:+, $1 закрыт}"
  fi
  if firewalld_on; then
    [ -n "$1" ] && firewall-cmd -q --permanent --remove-port="$1/tcp" 2>/dev/null || true
    firewall-cmd -q --permanent --add-port="$2/tcp" && firewall-cmd -q --reload && ok "firewalld: порт $2 открыт${1:+, $1 закрыт}"
  fi
}

pm() {
  if command -v apt-get >/dev/null; then echo apt; elif command -v dnf >/dev/null; then echo dnf
  elif command -v yum >/dev/null; then echo yum; elif command -v zypper >/dev/null; then echo zypper
  elif command -v pacman >/dev/null; then echo pacman; else echo none; fi
}
apt_wait() {  # на свежем VPS apt часто занят автообновлением: ждём с сообщением, а не молча
  local n=0
  command -v fuser >/dev/null || return 0
  while fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock >/dev/null 2>&1; do
    [ "$n" = 0 ] && echo "  apt занят (обычно автообновление системы после запуска VPS) — жду, до 10 минут…"
    n=$((n + 1)); [ "$n" -ge 120 ] && break; sleep 5
  done
}
APT_UPDATED=0
pkg_add() {  # pkg_add <пакет>… — установить пакетным менеджером системы (вывод — только при ошибке)
  local out rc=0
  case "$(pm)" in
    apt)
      export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a NEEDRESTART_SUSPEND=1
      # на свежем VPS списки пакетов пустые или устаревшие — без update apt не найдёт python3-venv
      apt_wait
      if [ "$APT_UPDATED" = 0 ]; then apt-get -o DPkg::Lock::Timeout=600 update -qq >/dev/null 2>&1 || true; APT_UPDATED=1; fi
      out="$(apt-get -o DPkg::Lock::Timeout=600 install -y -qq "$@" 2>&1)" || rc=$?
      [ "$rc" = 0 ] || printf '%s\n' "$out" | grep -E '^(E:|W:)' | head -5 >&2
      return "$rc" ;;
    dnf) dnf install -y -q "$@" >/dev/null ;;
    yum) yum install -y -q "$@" >/dev/null ;;
    zypper) zypper --non-interactive --quiet install "$@" >/dev/null ;;
    pacman) pacman -Sy --noconfirm --needed "$@" >/dev/null ;;
    *) return 1 ;;
  esac
}

restart() { systemctl restart eskadra; sleep 2; systemctl is-active --quiet eskadra && ok "панель перезапущена" || { journalctl -u eskadra -n 20 --no-pager; die "панель не запустилась"; }; }

sub_port() { cli status | sed -n 's/.*"subPort":\([0-9]*\).*/\1/p'; }

# ───────────────────────── адрес и состояние ─────────────────────────

cmd_url() {
  local url fp issuer st
  url="https://$(public_host):$(getenv FLEET_PORT)$(getenv FLEET_BASE_PATH)"
  fp="$(openssl x509 -in "$(getenv FLEET_TLS_CERT)" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2)"
  issuer="$(openssl x509 -in "$(getenv FLEET_TLS_CERT)" -noout -issuer 2>/dev/null)"
  st="$(cli status)"
  if [[ "$st" == *'"admins":0'* ]]; then
    printf '\n  %sСоздание владельца (ссылка одноразовая):%s\n  %s%s#/setup?token=%s%s\n' "$c_b" "$c_0" "$c_acc" "$url" "$(cli setup-token)" "$c_0"
  else
    printf '\n  %sПанель:%s %s%s%s\n' "$c_b" "$c_0" "$c_acc" "$url" "$c_0"
  fi
  if [[ "$issuer" == *"Let's Encrypt"* ]]; then
    printf '  %sСертификат Let'"'"'s Encrypt, действует до %s%s\n' "$c_dim" "$(openssl x509 -in "$(getenv FLEET_TLS_CERT)" -noout -enddate | cut -d= -f2)" "$c_0"
  else
    printf '  %sСвой сертификат. Отпечаток SHA-256:%s %s\n' "$c_dim" "$c_0" "$fp"
  fi
}

cmd_status() {
  local st active
  active="$(systemctl is-active eskadra 2>/dev/null || true)"
  st="$(cli status 2>/dev/null || echo '{}')"
  printf '\n  %s⛵ Эскадра%s  %s   версия %s\n' "$c_acc$c_b" "$c_0" "$( [ "$active" = active ] && echo "${c_ok}● работает${c_0}" || echo "${c_err}● $active${c_0}")" "$(cat "$PREFIX/app/VERSION" 2>/dev/null || echo '?')"
  printf '  %sпанель :%s · подписки :%s · серверов %s (без связи %s) · пользователей %s%s\n' "$c_dim" \
    "$(getenv FLEET_PORT)" "$(sed -n 's/.*"subPort":\([0-9]*\).*/\1/p' <<<"$st")" \
    "$(sed -n 's/.*"servers":\([0-9]*\).*/\1/p' <<<"$st")" "$(sed -n 's/.*"offline":\([0-9]*\).*/\1/p' <<<"$st")" \
    "$(sed -n 's/.*"users":\([0-9]*\).*/\1/p' <<<"$st")" "$c_0"
}

# ───────────────────────── порты и путь ─────────────────────────

rand_port() {
  local p
  for _ in $(seq 1 50); do
    p=$(( (RANDOM << 15 | RANDOM) % 50000 + 10000 ))
    case "$p" in 10085|51820|2053|2096|54321) continue ;; esac
    ss -ltnH "sport = :$p" 2>/dev/null | grep -q . || { echo "$p"; return; }
  done
  die "не нашёл свободный порт"
}

cmd_port() {
  local old new="${1:-}"
  old="$(getenv FLEET_PORT)"
  [ -n "$new" ] || new="$(prompt "Новый порт панели (Enter — случайный):")"
  [ -z "$new" ] || [ "$new" = random ] && new="$(rand_port)"
  [[ "$new" =~ ^[0-9]+$ ]] && [ "$new" -ge 1024 ] && [ "$new" -le 65535 ] || die "порт 1024–65535"
  ss -ltnH "sport = :$new" | grep -q . && die "порт $new занят"
  setenv FLEET_PORT "$new"; ufw_swap "$old" "$new" "eskadra panel"; restart; cmd_url
}

cmd_path() {
  local new="${1:-}"
  [ -n "$new" ] || new="$(prompt "Новый путь (Enter — случайный):")"
  if [ -z "$new" ]; then  # не «tr < /dev/urandom | head»: SIGPIPE + pipefail роняют скрипт молча
    while [ ${#new} -lt 12 ]; do new+="$(head -c 256 /dev/urandom | tr -dc 'a-z0-9')"; done; new="${new:0:12}"
  fi
  [[ "$new" =~ ^[A-Za-z0-9_-]+$ ]] || die "путь: латиница, цифры, - и _"
  setenv FLEET_BASE_PATH "/$new/"; restart; cmd_url
}

cmd_sub_port() {
  local old new="${1:-}"
  old="$(sub_port)"
  [ -n "$new" ] || new="$(prompt "Новый порт подписок (Enter — случайный):")"
  [ -n "$new" ] || new=random
  new="$(cli sub-port "$new")"
  ufw_swap "$old" "$new" "eskadra subscriptions"; restart
  ok "порт подписок: $new. Старые ссылки подписок перестанут работать — пользователям нужно обновить ссылку."
}

cmd_reset_password() {
  local r; r="$(cli reset-password "${1:-}")"
  printf '\n  Логин: %s%s%s\n  Новый пароль: %s%s%s\n  %sПароль показан один раз. Все сессии этого администратора завершены.%s\n' \
    "$c_b" "${r%% *}" "$c_0" "$c_acc" "${r#* }" "$c_0" "$c_dim" "$c_0"
}

# ───────────────────────── сертификаты ─────────────────────────

venv_python() {  # самый новый Python ≥ 3.9 с рабочими venv и ensurepip
  local py cands
  cands="$(compgen -c python3 | grep -E '^python3(\.[0-9]+)?$' | sort -t. -k2,2nr -u)"
  for py in $cands; do
    "$py" -c 'import sys, venv, ensurepip; sys.exit(sys.version_info < (3, 9))' 2>/dev/null && { command -v "$py"; return 0; }
  done
  return 1
}

ensure_python() {  # ставит Python ≥ 3.9 с venv, если его нет или он старый (RHEL 8: 3.6), и печатает путь
  local py v
  py="$(venv_python)" && { echo "$py"; return 0; }
  echo "  ставлю Python с модулем venv…" >&2
  case "$(pm)" in
    apt)
      pkg_add python3 python3-venv || true
      # Debian/Ubuntu: venv для конкретной версии лежит в python3.X-venv
      if ! venv_python >/dev/null; then
        v="$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || true)"
        [ -n "$v" ] && pkg_add "python$v-venv" || true
      fi ;;
    dnf|yum) pkg_add python3.12 || pkg_add python3.11 || pkg_add python39 || pkg_add python3 || true ;;
    zypper)  pkg_add python312 || pkg_add python311 || pkg_add python3 || true ;;
    pacman)  pkg_add python || true ;;
  esac
  py="$(venv_python)" || { printf '%s\n' "${c_err}✗ не удалось установить Python ≥ 3.9 с модулем venv (менеджер пакетов: $(pm))${c_0}" >&2; return 1; }
  echo "$py"
}

ensure_certbot() {
  # сертификаты на IP требуют certbot ≥ 5.3 (в репозиториях дистрибутивов он старее) — ставим в отдельный venv
  if [ -x "$CERTBOT" ] && "$CERTBOT" --version 2>/dev/null | awk '{split($2,v,"."); exit !(v[1]>5 || (v[1]==5 && v[2]>=4))}'; then return; fi
  local py out
  py="$(ensure_python)" || die "без Python certbot не поставить"
  echo "  ставлю certbot ($("$py" -V 2>&1))…"
  rm -rf "$PREFIX/certbot"
  "$py" -m venv "$PREFIX/certbot" || die "не удалось создать окружение Python для certbot"
  out="$("$PREFIX/certbot/bin/pip" install -q --disable-pip-version-check 'certbot>=5.4' 2>&1)" || { printf '%s\n' "$out" | tail -5 >&2; die "certbot не установился"; }
  "$CERTBOT" --version >/dev/null 2>&1 || die "certbot не установился"
}

write_hooks() {  # хуки certbot: порт 80 на время выпуска и каждого продления (ACME HTTP-01)
  # Служба, которая держит порт 80 в момент проверки (nginx, apache…), останавливается и сразу запускается обратно —
  # определяется при каждом запуске, а не один раз при выпуске. Системные службы и службы Эскадры не трогаются.
  # ESKADRA_STOP_80=0 при выпуске — не останавливать ничего.
  install -d -m 755 "$ETC/hooks"
  local stop=1; [ "${ESKADRA_STOP_80:-}" = 0 ] && stop=0
  cat > "$ETC/hooks/pre.sh" <<EOF
#!/bin/sh
: > "$ETC/hooks/stopped80"
if [ $stop = 1 ]; then
  for i in 1 2 3; do
    pid="\$(ss -ltnpH 'sport = :80' 2>/dev/null | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | head -1)"
    [ -n "\$pid" ] || break
    u="\$(ps -o unit= -p "\$pid" 2>/dev/null | tr -d ' ')"
    case "\$u" in *.service) ;; *) break ;; esac
    case "\$u" in eskadra*|fleet*|ssh.service|sshd.service|systemd-*|dbus*) break ;; esac
    systemctl stop "\$u" && echo "\$u" >> "$ETC/hooks/stopped80" || break
  done
fi
EOF
  cat >> "$ETC/hooks/pre.sh" <<'EOF'
if command -v ufw >/dev/null && ufw status | grep -q "^Status: active"; then ufw allow 80/tcp comment "eskadra acme" >/dev/null; fi
if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then firewall-cmd -q --add-port=80/tcp; fi
exit 0
EOF
  cat > "$ETC/hooks/post.sh" <<EOF
#!/bin/sh
if command -v ufw >/dev/null && ufw status | grep -q "^Status: active"; then ufw delete allow 80/tcp >/dev/null 2>&1 || true; fi
if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then firewall-cmd -q --remove-port=80/tcp || true; fi
# остановленное на время проверки — обратно, даже если выпуск не удался
for u in \$(cat "$ETC/hooks/stopped80" 2>/dev/null); do systemctl start "\$u" || true; done
rm -f "$ETC/hooks/stopped80"
exit 0
EOF
  chmod 755 "$ETC/hooks/pre.sh" "$ETC/hooks/post.sh"
}

# certbot по очереди с узлом флота на этом же сервере (общий каталог Let's Encrypt, fleet-core cb): иначе второй
# экземпляр падает с «Another instance of Certbot is already running»
certbot_q() {
  install -d -m 700 "$LE"
  if command -v flock >/dev/null; then flock -w 600 "$LE/.eskadra.lock" "$CERTBOT" "$@"; else "$CERTBOT" "$@"; fi
}

install_renew_timer() {
  cat > /etc/systemd/system/eskadra-certbot.service <<EOF
[Unit]
Description=Eskadra: renew Let's Encrypt certificate
[Service]
Type=oneshot
ExecStart=$( command -v flock >/dev/null && echo "$(command -v flock) -w 900 $LE/.eskadra.lock " || true )$CERTBOT ${LE_ARGS[*]} renew -q
EOF
  cat > /etc/systemd/system/eskadra-certbot.timer <<'EOF'
[Unit]
Description=Eskadra: renew Let's Encrypt certificate twice a day
[Timer]
OnCalendar=*-*-* 00,12:00:00
RandomizedDelaySec=1h
Persistent=true
[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload
  systemctl enable --now eskadra-certbot.timer >/dev/null
}

cmd_cert_deploy() {  # deploy-hook certbot: новый сертификат → панель (она перечитывает его сама)
  local live="$LE/live/eskadra"
  [ -s "$live/fullchain.pem" ] || die "нет сертификата Let's Encrypt"
  panel_put "$DATA/tls/key.pem" 600 < "$live/privkey.pem"
  panel_put "$DATA/tls/cert.pem" 644 < "$live/fullchain.pem"
}

legacy_le_drop() {  # убрать сертификат Эскадры из общего /etc/letsencrypt (так было до v0.5.5)
  rm -rf /etc/letsencrypt/live/eskadra /etc/letsencrypt/archive/eskadra /etc/letsencrypt/renewal/eskadra.conf
}

cmd_cert_migrate() {  # сертификат, выпущенный в общий /etc/letsencrypt, — в свой каталог, без перевыпуска
  local old=/etc/letsencrypt
  [ -f "$old/renewal/eskadra.conf" ] && [ ! -f "$LE/renewal/eskadra.conf" ] || return 0
  install -d -m 700 "$LE" "$LE/live" "$LE/archive" "$LE/renewal"
  cp -a "$old/archive/eskadra" "$LE/archive/"
  cp -a "$old/live/eskadra" "$LE/live/"           # ссылки в live относительные (../../archive/…)
  # аккаунт, которым выпущен сертификат
  local acct; acct="$(sed -n 's/^account = //p' "$old/renewal/eskadra.conf")"
  if [ -n "$acct" ]; then
    local d; d="$(dirname "$(grep -rl --include=regr.json "$acct" "$old/accounts" 2>/dev/null | head -1)" 2>/dev/null || true)"
    if [ -n "$d" ] && [ -d "$d" ]; then
      install -d -m 700 "$LE/accounts"
      (cd "$old/accounts" && cp -a --parents "${d#"$old/accounts/"}" "$LE/accounts/")
    fi
  fi
  sed "s|$old/|$LE/|g" "$old/renewal/eskadra.conf" > "$LE/renewal/eskadra.conf"
  chmod 600 "$LE/renewal/eskadra.conf"
  if [ -x "$CERTBOT" ] && "$CERTBOT" "${LE_ARGS[@]}" certificates --cert-name eskadra 2>/dev/null | grep -q 'Certificate Name: eskadra'; then
    legacy_le_drop
    install_renew_timer
    ok "сертификат Let's Encrypt перенесён в $LE — системный certbot его больше не трогает"
  else
    rm -rf "$LE"; warn "не удалось перенести сертификат Let's Encrypt; перевыпустите: eskadra cert letsencrypt"
  fi
}

cmd_letsencrypt() {  # cmd_letsencrypt [ip|domain] [домен[,домен…]] — первый — домен панели, остальные (адрес подписок) — в том же сертификате
  local kind="${1:-}" domain="${2:-}" ip holder unit="" email args=() d doms=()
  ip="$(own_ip)"
  [ -n "$ip" ] || die "не удалось определить внешний IP этого сервера"
  if [ -z "$kind" ]; then
    printf '\n  %sСертификат Let'"'"'s Encrypt%s\n' "$c_b" "$c_0"
    printf '   1) На IP %s — без домена, сертификат на 6 дней, продлевается сам\n' "$ip"
    printf '   2) На домен — нужен домен с A-записью на %s, сертификат на 90 дней\n' "$ip"
    case "$(prompt "  Выберите [1]:" 1)" in 2) kind=domain ;; *) kind=ip ;; esac
  fi
  if [ "$kind" = domain ]; then
    [ -n "$domain" ] || domain="$(prompt "  Домен:")"
    IFS=, read -r -a doms <<< "${domain// /}"
    [ "${#doms[@]}" -gt 0 ] || die "неверный домен"
    local resolved
    for d in "${doms[@]}"; do
      [[ "$d" =~ ^[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || die "неверный домен: $d"
      resolved="$(getent ahostsv4 "$d" | awk 'NR==1{print $1}')"
      [ "$resolved" = "$ip" ] || warn "домен $d указывает на ${resolved:-ничто}, а сервер — $ip. Выпуск, скорее всего, не пройдёт."
    done
    domain="${doms[0]}"
  fi

  # порт 80 нужен валидатору Let's Encrypt (HTTP-01) на время выпуска и каждого продления
  # служба на порту 80 останавливается на время проверки и сразу запускается обратно (хуки, write_hooks) — всегда,
  # при выпуске, переносе, обновлении и каждом продлении; ESKADRA_STOP_80=0 — не трогать
  holder="$(port80_holder)"
  if [ -n "$holder" ]; then
    read -r _ _ unit <<< "$holder"
    if [ "${ESKADRA_STOP_80:-}" = 0 ]; then die "порт 80 занят: ${holder%% *}${unit:+ ($unit)}, а ESKADRA_STOP_80=0 — освободите порт и повторите"
    elif [ -z "$unit" ]; then die "порт 80 занят: ${holder%% *} (pid $(echo "$holder" | cut -d' ' -f2)) — это не служба systemd, остановить её на время выпуска нельзя; освободите порт и повторите"
    elif [[ "$unit" =~ ^(eskadra|fleet|ssh\.service|sshd\.service|systemd-|dbus) ]]; then die "порт 80 занят системной службой $unit — её не останавливаю; освободите порт и повторите"
    else ok "порт 80 занят: ${holder%% *} ($unit) — на время проверки Let's Encrypt (~30 с) служба остановится и сразу запустится обратно, так же при каждом продлении"
    fi
  fi
  printf '  Выпуск означает согласие с условиями Let'"'"'s Encrypt: https://letsencrypt.org/repository/\n'
  [[ "$(prompt "  Согласны? [Y/n]:" y)" =~ ^(n|N|н|Н)$ ]] && die "отменено"
  email="$(prompt "  Email для уведомлений Let's Encrypt (Enter — без email):")"

  ensure_certbot
  write_hooks
  certbot_q "${LE_ARGS[@]}" delete --cert-name eskadra --non-interactive >/dev/null 2>&1 || true
  args=("${LE_ARGS[@]}" certonly -q --standalone --non-interactive --agree-tos --cert-name eskadra --key-type ecdsa
        --pre-hook "$ETC/hooks/pre.sh" --post-hook "$ETC/hooks/post.sh" --deploy-hook "/usr/local/bin/eskadra cert-deploy")
  if [ -n "$email" ]; then args+=(-m "$email"); else args+=(--register-unsafely-without-email); fi
  if [ "$kind" = ip ]; then args+=(--preferred-profile shortlived --ip-address "$ip"); else for d in "${doms[@]}"; do args+=(-d "$d"); done; fi
  [ "${ESKADRA_LE_STAGING:-}" = 1 ] && args+=(--test-cert)   # для проверок: тестовый CA, без лимитов боевого
  echo "  выпускаю сертификат…"
  certbot_q "${args[@]}" || die "Let's Encrypt не выдал сертификат (см. вывод выше). Частая причина — порт 80 закрыт снаружи: проверьте firewall в панели хостера (порт 80/tcp должен быть открыт для всех)."
  if [ "$kind" = ip ]; then
    # 6-дневный сертификат: продлевать за 3 дня до окончания (таймер проверяет дважды в сутки)
    local rc="$LE/renewal/eskadra.conf"
    grep -q '^renew_before_expiry' "$rc" && sed -i 's/^renew_before_expiry.*/renew_before_expiry = 3 days/' "$rc" || sed -i '1a renew_before_expiry = 3 days' "$rc"
  fi
  cmd_cert_deploy
  install_renew_timer
  legacy_le_drop
  local host; if [ "$kind" = domain ]; then host="$domain"; else host="$ip"; fi
  setenv FLEET_PUBLIC_HOST "$host"
  setenv FLEET_SUB_TLS 1
  # адрес подписок: если он среди доменов сертификата (ESKADRA_SUB_HOST — из панели) — он, иначе — адрес панели
  local sub="$host"
  for d in "${doms[@]}"; do if [ "$d" = "${ESKADRA_SUB_HOST:-}" ]; then sub="$d"; fi; done
  cli sub-port "" "$sub" >/dev/null
  ok "сертификат Let's Encrypt выпущен на ${doms[*]:-$host}, продление — автоматически"
  [ "${ESKADRA_INSTALL:-}" = 1 ] && return 0   # установщик сам запустит панель
  restart
  warn "подписки отдаются по HTTPS: https://$sub:$(sub_port)/…"
  cmd_url
}

cmd_cert() {
  case "${1:-show}" in
    show) openssl x509 -in "$(getenv FLEET_TLS_CERT)" -noout -subject -issuer -enddate -fingerprint -sha256
          systemctl is-active --quiet eskadra-certbot.timer && echo "автопродление: включено ($(systemctl show eskadra-certbot.timer -p NextElapseUSecRealtime --value))" || true ;;
    letsencrypt|le) shift; cmd_letsencrypt "${1:-}" "${2:-}" ;;
    set)
      [ -f "${2:-}" ] && [ -f "${3:-}" ] || die "eskadra cert set <fullchain.pem> <privkey.pem>"
      panel_put "$DATA/tls/cert.pem" 644 < "$2"; panel_put "$DATA/tls/key.pem" 600 < "$3"
      restart ;;
    *) die "eskadra cert show | letsencrypt [ip|domain <домен>] | set <cert> <key>" ;;
  esac
}

menu_cert() {
  printf '\n'; cmd_cert show || true
  printf '\n   1) Let'"'"'s Encrypt на IP\n   2) Let'"'"'s Encrypt на домен\n   0) Назад\n'
  case "$(prompt "  Выберите:")" in 1) cmd_letsencrypt ip ;; 2) cmd_letsencrypt domain ;; esac
}

# ───────────────────────── конфликты ядер на этом сервере ─────────────────────────

xui_present() { [ -d /usr/local/x-ui ] || [ -d /etc/x-ui ] || systemctl cat x-ui.service >/dev/null 2>&1; }

remove_xui() {
  # $DATA пишет панель: не chmod'им чужой каталог по симлинку (mkdir -p существующий не трогает)
  # и не перезаписываем существующий файл (set -C: O_EXCL, на симлинке тоже отказ)
  local d; d="$DATA/backup"; [ -L "$d" ] && rm -f "$d"; mkdir -p -m 700 "$d"
  local f; f="$d/x-ui-$(date -u +%Y%m%dT%H%M%SZ).tar.gz"
  ( set -C; tar -czf - /etc/x-ui /usr/local/x-ui/bin/config.json 2>/dev/null > "$f" ) || true
  systemctl disable --now x-ui 2>/dev/null || true
  rm -rf /usr/local/x-ui /etc/x-ui
  rm -f /etc/systemd/system/x-ui.service /usr/bin/x-ui
  systemctl daemon-reload
  ok "3x-ui удалён. База и конфиг сохранены: $f"
}

# «Удалить или дополнить»: решает, что делать с уже установленными ядрами, чтобы не было конфликта
cmd_conflicts() {
  local choice found=0
  if xui_present; then
    found=1
    local v; v="$(/usr/local/x-ui/x-ui -v 2>/dev/null | head -1 || true)"
    printf '\n  %sНайден 3x-ui%s %s (%s)\n' "$c_b" "$c_0" "$v" "$(systemctl is-active x-ui 2>/dev/null || echo '?')"
    printf '   1) Дополнить — оставить 3x-ui. Если добавить этот сервер как узел, Эскадра положит свои inbounds\n'
    printf '      в Xray 3x-ui и не запустит второй Xray. Пользователи 3x-ui продолжат работать.\n'
    printf '   2) Удалить 3x-ui — база и конфиг сохранятся в %s/backup, Эскадра поставит своё ядро.\n' "$DATA"
    printf '      Пользователи 3x-ui потеряют доступ.\n'
    choice="${ESKADRA_XUI:-}"
    [ -n "$choice" ] || choice="$(prompt "  Выберите [1]:" 1)"
    case "$choice" in
      2|remove) yes_no "  Точно удалить 3x-ui?" && remove_xui || ok "3x-ui оставлен" ;;
      *) ok "3x-ui оставлен — Эскадра будет его дополнять" ;;
    esac
  fi
  for svc in xray sing-box v2ray hysteria-server; do
    systemctl is-active --quiet "$svc" 2>/dev/null || continue
    found=1
    printf '\n  %sРаботает %s.service%s (не 3x-ui)\n' "$c_b" "$svc" "$c_0"
    printf '   1) Оставить — Эскадра не запустит своё ядро этого типа на этом сервере\n'
    printf '   2) Остановить и отключить — файлы не удаляются, Эскадра поставит своё ядро\n'
    case "$(prompt "  Выберите [1]:" 1)" in
      2) systemctl disable --now "$svc" && ok "$svc остановлен и отключён" ;;
      *) ok "$svc оставлен" ;;
    esac
  done
  [ "$found" = 1 ] || ok "сторонних VPN-ядер на этом сервере нет"
}

# ───────────────────────── обслуживание ─────────────────────────

cmd_update() {
  local repo; repo="$(cat "$PREFIX/app/REPO" 2>/dev/null || true)"
  [ -n "$repo" ] || die "неизвестен репозиторий релизов"
  # установщик — из тега той же версии, а не из ветки main: туда могут попасть изменения до релиза (или чужие)
  local ver="${1:-latest}" ref
  if [ "$ver" = latest ]; then
    ref="$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" | python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"])' 2>/dev/null || true)"
  else
    ref="v${ver#v}"
  fi
  [[ "$ref" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "не удалось определить версию релиза ($ver)"
  ESKADRA_REPO="$repo" ESKADRA_VERSION="$ref" bash <(curl -fsSL "https://raw.githubusercontent.com/$repo/$ref/scripts/install.sh")
}

# Root-помощник обновления (юнит eskadra-update.path): кнопка «Обновить» в панели кладёт запрос с версией,
# помощник запускает обычное обновление и пишет журнал, который панель показывает. От панели — только версия.
cmd_update_apply() {
  local dir="$DATA/update" req ver code=0 json
  req="$dir/request.json"
  # запрос читается и удаляется от имени панели: root не идёт по подложенному симлинку
  json="$(as_panel cat "$req" 2>/dev/null)" || return 0
  as_panel rm -f "$req" || true
  jget() { printf '%s' "$json" | python3 -c 'import json,sys
v = json.load(sys.stdin).get(sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else "")
print(",".join(v) if isinstance(v, list) else v)' "$@" 2>/dev/null || true; }
  ver="$(jget version latest)"; [ -n "$ver" ] || ver=latest
  # выпуск сертификата панели из «Сервиса подписок»: домен панели и адрес подписок в одном сертификате
  local action doms subh
  action="$(jget action)"
  if [ "$action" = cert ]; then
    doms="$(jget domains)"
    subh="$(jget subHost)"
    [[ "$doms" =~ ^[A-Za-z0-9.,-]{4,1000}$ ]] || doms=""
    [[ "$subh" =~ ^[A-Za-z0-9.-]{1,253}$ ]] || subh=""
    panel_log_reset "$dir/log"
    echo "start $(date -Is) cert $doms" | panel_log "$dir/log"
    if [ -n "$doms" ]; then ( ESKADRA_SUB_HOST="$subh" cmd_letsencrypt domain "$doms" ) 2>&1 | panel_log "$dir/log" || code=$?
    else echo "неверный список доменов" | panel_log "$dir/log"; code=1; fi
    echo "exit=$code" | panel_log "$dir/log"
    return 0
  fi
  [[ "$ver" =~ ^(latest|v?[0-9]+\.[0-9]+\.[0-9]+)$ ]] || ver=latest
  panel_log_reset "$dir/log"
  echo "start $(date -Is) $ver" | panel_log "$dir/log"
  ( cmd_update "$ver" ) 2>&1 | panel_log "$dir/log" || code=$?
  echo "exit=$code" | panel_log "$dir/log"
}

# ───────────────────────── главный сервер как узел ─────────────────────────

# Root-помощник (юнит eskadra-selfnode.path): панель работает без root и просит доступ к своему же хосту.
# Делает ровно то, что bootstrap-сниппет узла, но ключ панели пускается только с 127.0.0.1.
# Принимает от панели только id и публичный ключ строгого формата — никаких команд.
cmd_self_node_apply() {
  local dir="$DATA/selfnode" req out id pubkey port fp line json
  req="$dir/request.json"; out="$dir/result.json"
  # запрос читается и удаляется, ответ пишется — от имени панели (см. as_panel)
  json="$(as_panel cat "$req" 2>/dev/null)" || return 0
  as_panel rm -f "$req" || true
  id="$(printf '%s' "$json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("id",""))' 2>/dev/null || true)"
  pubkey="$(printf '%s' "$json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("pubkey",""))' 2>/dev/null || true)"
  reply() {  # reply true|false [порт отпечаток | сообщение]
    python3 -c 'import json,sys
ok = sys.argv[2] == "true"
r = {"id": sys.argv[1], "ok": ok}
if ok: r.update(sshPort=int(sys.argv[3]), hostKeyFp=sys.argv[4])
else: r["error"] = sys.argv[3]
print(json.dumps(r))' "$id" "$@" | panel_put "$out" 600
  }
  [[ "$id" =~ ^srv-[a-z0-9x]{4,16}$ ]] || { reply false "неверный id"; return 0; }
  [[ "$pubkey" =~ ^ssh-ed25519\ [A-Za-z0-9+/]{60,80}=*\ fleet-panel/${id}$ ]] || { reply false "неверный ключ"; return 0; }
  [ -r /etc/ssh/ssh_host_ed25519_key.pub ] || { reply false "на сервере нет ed25519-ключа хоста SSH"; return 0; }

  install -d -m 755 /etc/fleet
  printf '127.0.0.1\n::1\n' > /etc/fleet/panel-ips
  id fleet >/dev/null 2>&1 || useradd --create-home --shell /bin/bash fleet
  usermod -p '*' fleet
  install -d -m 700 -o fleet -g fleet /home/fleet/.ssh
  touch /home/fleet/.ssh/authorized_keys
  line="from=\"127.0.0.1,::1\",restrict,port-forwarding,permitopen=\"127.0.0.1:10085\" $pubkey"
  grep -qxF "$line" /home/fleet/.ssh/authorized_keys || echo "$line" >> /home/fleet/.ssh/authorized_keys
  chown fleet:fleet /home/fleet/.ssh/authorized_keys; chmod 600 /home/fleet/.ssh/authorized_keys
  command -v restorecon >/dev/null && restorecon -R /home/fleet/.ssh || true
  install -d -m 750 /etc/sudoers.d
  echo 'fleet ALL=(root) NOPASSWD:ALL' > /etc/sudoers.d/90-fleet-bootstrap
  chmod 440 /etc/sudoers.d/90-fleet-bootstrap
  visudo -cf /etc/sudoers.d/90-fleet-bootstrap >/dev/null || { rm -f /etc/sudoers.d/90-fleet-bootstrap; reply false "sudoers не прошёл проверку"; return 0; }

  install -d /run/sshd
  port="$(sshd -T 2>/dev/null | awk '$1=="port"{print $2; exit}')"
  fp="$(ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub | awk '{print $2}')"
  [ -n "$port" ] && [ -n "$fp" ] || { reply false "не удалось определить порт SSH или ключ хоста"; return 0; }
  reply true "$port" "$fp"
  logger -t eskadra "self-node: panel key for $id added (from 127.0.0.1)" 2>/dev/null || true
}

fw_close() {  # закрыть в ufw / firewalld все порты Эскадры (панель, подписки, ACME)
  local n port
  if ufw_on; then
    # номера правил с комментарием eskadra, с конца — чтобы номера не сдвигались
    for n in $(ufw status numbered | grep -i 'eskadra' | sed -nE 's/^\[ *([0-9]+)\].*/\1/p' | sort -rn); do
      ufw --force delete "$n" >/dev/null || true
    done
  fi
  if firewalld_on; then
    for port in "$(getenv FLEET_PORT)" "$(sub_port 2>/dev/null || true)"; do
      [ -n "$port" ] && firewall-cmd -q --permanent --remove-port="$port/tcp" 2>/dev/null || true
    done
    firewall-cmd -q --reload || true
  fi
}

# На сервере работает и узел флота (nodekit, ядра): у панели и узла общий каталог $ETC (там конфиги ядер, сертификаты
# узла, общий каталог Let's Encrypt) и общий таймер продления eskadra-certbot — панель удаляется без них.
node_here() { [ -x /usr/local/sbin/fleet-core ] || [ -d "$ETC/xray" ] || [ -d "$ETC/sing-box" ] || [ -d "$ETC/telemt" ]; }

# Узел на этом сервере — полностью: ядра и их службы, конфиги и сертификаты, nodekit, firewall Эскадры, пользователи
# fleet и fleet-mgmt. Настройки SSH и консольный пользователь fleetadmin остаются — иначе можно потерять доступ.
node_remove() {
  local u
  for u in $(systemctl list-unit-files --no-legend 'eskadra-*' 2>/dev/null | awk '{print $1}') fleet-fw.service; do
    systemctl disable --now "$u" >/dev/null 2>&1 || systemctl stop "$u" >/dev/null 2>&1 || true
  done
  rm -f /etc/systemd/system/eskadra-*.service /etc/systemd/system/eskadra-*.timer /etc/systemd/system/fleet-fw.service
  nft delete table inet fleet >/dev/null 2>&1 || true
  # каталоги узла в $ETC; сертификаты Let's Encrypt узла — все, кроме сертификата панели (eskadra)
  rm -rf "$ETC/xray" "$ETC/sing-box" "$ETC/telemt" "$ETC/tls" "$ETC/hy2-hop" "$ETC/hy2-relay" "$ETC/netfair"
  for f in "$LE"/renewal/*.conf; do
    [ -f "$f" ] || continue
    u="$(basename "$f" .conf)"; [ "$u" = eskadra ] && continue
    rm -rf "$LE/live/$u" "$LE/archive/$u" "$f"
  done
  rm -rf /usr/local/lib/eskadra /etc/fleet /var/lib/fleet
  rm -f /usr/local/sbin/fleet-* /usr/local/sbin/fleetctl /etc/sudoers.d/90-fleet /etc/sudoers.d/90-fleet-bootstrap /etc/sudoers.d/91-fleet-shell
  pkill -u fleet >/dev/null 2>&1 || true
  userdel -r fleet >/dev/null 2>&1 || true
  userdel fleet-mgmt >/dev/null 2>&1 || true
  systemctl daemon-reload
  warn "оставлены настройки SSH (/etc/ssh/sshd_config.d/00-fleet-*.conf) и консольный пользователь fleetadmin — чтобы не потерять доступ к серверу"
}

# Только файлы панели (программа, база, настройки панели, её сертификат) — узел на этом сервере не задевается.
# Та же очистка — в переносе панели (server/src/migrate.ts), когда новый сервер остался после неудачной попытки.
panel_purge() {
  rm -rf "$PREFIX" "$DATA" /var/log/eskadra-install.log
  rm -f /usr/local/bin/eskadra "$ENVF" "$ETC/.setup-done"
  rm -rf "$ETC/hooks" "$LE/live/eskadra" "$LE/archive/eskadra" "$LE/renewal/eskadra.conf"
  userdel eskadra >/dev/null 2>&1 || true
}

cmd_uninstall() {  # cmd_uninstall [--purge|--keep] [--with-node] [--yes]
  local purge="" node=keep yes="" a unit
  for a in "$@"; do case "$a" in --purge) purge=--purge ;; --keep) purge=keep ;; --with-node) node=remove ;; --yes|-y) yes=1 ;; esac; done
  if [ -z "$purge" ]; then
    printf '\n  %sУдаление Эскадры%s\n' "$c_b" "$c_0"
    printf '   1) Удалить программу, сохранить данные и настройки (%s, %s) — можно поставить заново и продолжить\n' "$DATA" "$ETC"
    printf '   2) Удалить полностью: база, ключи узлов, бэкапы, настройки, сертификат, порты в firewall, пользователь eskadra\n'
    printf '   0) Отмена\n'
    case "$(prompt "  Выберите [0]:" 0)" in 1) purge=keep ;; 2) purge=--purge ;; *) return 0 ;; esac
  fi
  # узел на этом же сервере: по умолчанию остаётся (VPN продолжает работать), удалить — только явным выбором
  if node_here && [ "$node" = keep ] && [ -z "$yes" ]; then
    local running; running="$(systemctl list-units --no-legend --state=active 'eskadra-*.service' 2>/dev/null | awk '{print $1}' | grep -v '^eskadra-\(selfnode\|update\|certbot\)' | paste -sd' ' || true)"
    printf '\n  %sНа этом сервере работает и узел флота%s%s\n' "$c_b" "$c_0" "${running:+ ($running)}"
    printf '   1) Оставить узел — удалить только панель: ядра, их конфиги и сертификаты не трогаются, VPN работает\n'
    printf '   2) Удалить всё — и панель, и узел: ядра, конфиги, сертификаты, nodekit, firewall Эскадры, пользователь fleet\n'
    case "$(prompt "  Выберите [1]:" 1)" in 2) node=remove ;; esac
  fi
  if [ "$purge" = --purge ] || [ "$node" = remove ]; then
    if [ "$purge" = --purge ]; then
      warn "Будут удалены база панели, ключи SSH к узлам и локальные бэкапы. Узлы продолжат работать, но управлять ими будет нечем:"
      warn "на других узлах останутся пользователь fleet, nodekit и правила firewall — их снимают на самих узлах."
    fi
    if [ "$node" = remove ]; then warn "Узел на этом сервере будет удалён: ядра остановятся, клиенты через него больше не подключатся."; fi
    [ -n "$yes" ] || [ "$(prompt "  Для подтверждения введите УДАЛИТЬ:")" = "УДАЛИТЬ" ] || { ok "отменено"; return 0; }
    if [ "$purge" = --purge ]; then fw_close; fi
  else
    [ -n "$yes" ] || yes_no "  Удалить программу? Данные в $DATA и настройки в $ETC сохранятся." || return 0
  fi
  # по одному юниту: «disable --now a b» падает целиком, если одного юнита нет, и панель оставалась запущенной
  for unit in eskadra.service eskadra-selfnode.path eskadra-selfnode.service eskadra-update.path eskadra-update.service; do
    systemctl disable --now "$unit" >/dev/null 2>&1 || systemctl stop "$unit" >/dev/null 2>&1 || true
  done
  rm -f /etc/systemd/system/eskadra.service /etc/systemd/system/eskadra-selfnode.* /etc/systemd/system/eskadra-update.*
  if node_here && [ "$node" = keep ]; then
    # таймер продления общий с узлом: остаётся; если его переписала панель — узел возвращает свой (fleet-core cert-renew)
    if [ -f /etc/systemd/system/eskadra-certbot.service ] && ! grep -q 'cert-renew' /etc/systemd/system/eskadra-certbot.service; then
      /usr/local/sbin/fleet-core cert-status >/dev/null 2>&1 || true
    fi
  else
    systemctl disable --now eskadra-certbot.timer >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/eskadra-certbot.*
  fi
  pkill -u eskadra >/dev/null 2>&1 || true
  systemctl daemon-reload
  if [ "$node" = remove ]; then node_remove; fi
  if [ "$purge" = --purge ]; then
    legacy_le_drop
    rm -rf /etc/letsencrypt/live/eskadra /etc/letsencrypt/archive/eskadra /etc/letsencrypt/renewal/eskadra.conf
    panel_purge
    if ! node_here; then rm -rf "$ETC" /var/log/eskadra-letsencrypt; fi
    ok "Эскадра удалена полностью$(node_here && echo ' (узел на этом сервере оставлен и работает)'). Поставить заново: bash <(curl -fsSL https://raw.githubusercontent.com/deluwr/eskadra/main/scripts/install.sh)"
  else
    rm -rf "$PREFIX"; rm -f /usr/local/bin/eskadra
    ok "программа удалена$(node_here && echo ', узел на этом сервере оставлен'). Данные: $DATA, настройки: $ETC — повторная установка подхватит их. Полностью: eskadra uninstall --purge"
  fi
  exit 0   # самого скрипта и панели больше нет — в меню возвращаться некуда
}

usage() {
  cat <<EOF
Флот (интерактивно):
  fleet [раздел]          overview | servers | users | configs | cores | backups | audit
Панель:
  status | url | start | stop | restart | logs
  port [N|random]         порт панели (ufw обновится)
  path [имя]              секретный путь панели
  sub-port [N|random]     порт подписок
  cert [show|letsencrypt [ip|domain <домен>[,<домен>…]]|set <cert> <key>]
  conflicts               3x-ui / xray / sing-box на этом сервере: дополнить или удалить
  reset-password [логин]  новый пароль администратора
  disable-2fa <логин>     отключить 2FA
  admins | backup | update [версия]
  uninstall [--purge] [--with-node] [--yes]
                          удалить программу (данные сохраняются) или полностью; узел флота
                          на этом сервере остаётся, если не указать --with-node
EOF
}

menu() {
  while true; do
    cmd_status
    cat <<EOF

  ${c_b}Флот${c_0}                          ${c_b}Панель${c_0}
   1) Обзор                       8) Адрес входа
   2) Серверы                     9) Сертификат (Let's Encrypt)
   3) Пользователи               10) Порт панели
   4) Конфигурации               11) Секретный путь
   5) Ядра                       12) Порт подписок
   6) Бэкапы                     13) Сбросить пароль / 2FA
   7) Аудит                      14) 3x-ui и другие ядра
                                 15) Перезапуск · 16) Логи
                                 17) Обновить · 18) Удалить
   0) Выход
EOF
    local c; c="$(prompt "  Выберите:")"
    case "$c" in
      1) tui overview || true ;;
      2) tui servers || true ;;
      3) tui users || true ;;
      4) tui configs || true ;;
      5) tui cores || true ;;
      6) tui backups || true ;;
      7) tui audit || true ;;
      8) cmd_url ;;
      9) menu_cert ;;
      10) cmd_port ;;
      11) cmd_path ;;
      12) cmd_sub_port ;;
      13) cli admins
          local u; u="$(prompt "  Логин (Enter — owner):")"
          case "$(prompt "  1) новый пароль  2) отключить 2FA [1]:" 1)" in 2) [ -n "$u" ] && cli disable-2fa "$u" ;; *) cmd_reset_password "$u" ;; esac ;;
      14) cmd_conflicts ;;
      15) restart ;;
      16) journalctl -u eskadra -n 60 --no-pager ;;
      17) cmd_update ;;
      18) cmd_uninstall ;;
      0|q|"") exit 0 ;;
      *) echo "  нет такого пункта" ;;
    esac
    [[ "$c" =~ ^[1-7]$ ]] || prompt "  Enter — назад в меню" >/dev/null
  done
}

case "${1:-menu}" in
  menu) menu ;;
  fleet) tui "${2:-}" ;;
  status) cmd_status ;;
  url) cmd_url ;;
  start) systemctl start eskadra && ok запущена ;;
  stop) systemctl stop eskadra && ok остановлена ;;
  restart) restart ;;
  logs) journalctl -u eskadra -n "${2:-100}" --no-pager ;;
  port) cmd_port "${2:-}" ;;
  path) cmd_path "${2:-}" ;;
  sub-port) cmd_sub_port "${2:-}" ;;
  cert) shift; cmd_cert "$@" ;;
  cert-deploy) cmd_cert_deploy ;;
  cert-migrate) cmd_cert_migrate ;;
  cert-hooks)   # обновление: хуки и таймер продления — в текущем виде
    [ -f "$ETC/hooks/pre.sh" ] && write_hooks || true
    # таймер узла (fleet-core cert-renew) продлевает и сертификат панели, по очереди с остальными — его не трогаем
    if [ -f "$LE/renewal/eskadra.conf" ] && ! grep -qs cert-renew /etc/systemd/system/eskadra-certbot.service; then install_renew_timer; fi ;;
  self-node-apply) cmd_self_node_apply ;;
  update-apply) cmd_update_apply ;;
  conflicts) cmd_conflicts ;;
  reset-password) cmd_reset_password "${2:-}" ;;
  disable-2fa) [ -n "${2:-}" ] || die "eskadra disable-2fa <логин>"; cli disable-2fa "$2" ;;
  admins) cli admins ;;
  backup) cli backup ;;
  update) cmd_update "${2:-}" ;;
  uninstall) cmd_uninstall "${@:2}" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
